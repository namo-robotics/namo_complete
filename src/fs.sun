// fs.sun - the few file helpers std.io does not already provide.
//
// std.io takes a `ref String` path directly, so reading and writing whole
// files is done with read_to_string / write_string at the call site. What is
// left here is the handful of calls whose failure is not an error to anyone --
// a directory that already exists, a file that is already gone -- and two
// descriptor helpers for fds we did not open ourselves.
//
// Directories are created 0700 and every file we write lives inside one, so
// nothing here needs to name a file mode.
//
// std.io borrows its paths as `ref String`, not `const ref`, so a path read
// out of a `const ref Config` cannot be opened. That is why `cfg` stays `ref`
// in every function that opens one of its files (and `path` does here), while
// the rest of the program borrows it const.

public module namo {
  using std;
  using std.io;

  public var MODE_0700: i32 = 448;

  // Create a directory, tolerating "already exists".
  public function ensure_dir(alloc: ref HeapAllocator, path: ref String) void {
    try {
      make_dir(path, MODE_0700);
    } catch (e: IError) {
      // Already there, or the parent is missing; the caller finds out when
      // the write fails.
    }
  }

  // mkdir -p: create every component of an absolute path.
  public function ensure_dir_p(alloc: ref HeapAllocator, path: const ref String) void {
    var acc = String(alloc, "");
    for (var i: i64 = 0; i < path.length(); i = i + 1) {
      var c: u8 = path.at(i);
      acc.append_char(c);
      if (c == 47 and acc.length() > 1) {
        ensure_dir(alloc, acc);
      }
    }
    if (acc.length() > 0) {
      ensure_dir(alloc, acc);
    }
  }

  // Remove a file while tolerating an already-missing path.
  public function remove_path(alloc: ref HeapAllocator, path: ref String) void {
    try {
      remove_file(path);
    } catch (e: IError) {
      // Not there is the state we wanted anyway.
    }
  }

  // Drain a descriptor to end-of-file. Used for stdin, which arrives as fd 0
  // and is not ours to close -- File.close() leaves fd 0 alone.
  public function read_fd(alloc: ref HeapAllocator, fd: i32) String {
    var f = File();
    f.adopt(fd);
    var out = String(alloc, "");
    try {
      out = f.read_all(alloc);
    } catch (e: IError) {
      out = String(alloc, "");
    }
    return out;
  }

  // Close a descriptor we hold nothing else for. The daemon needs this for
  // the inherited descriptors it drops on startup.
  public function close_fd(fd: i32) void {
    var f = File();
    f.adopt(fd);
    f.close();
  }
}
