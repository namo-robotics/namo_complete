// redact.sun - decide what leaves the machine.
//
// Both callers now hand history in the same shape: the interactive path
// (Alt-O / Alt-A / Alt-G) pipes `fc -ln` on stdin, the daemon reads the
// snapshot file the shell refreshes at each prompt. The directory listing is
// no longer part of that stream -- the binary enumerates the directory itself
// (see list_dir in daemon.sun).
//
// This is the only thing between the shell history and the network, so it is
// applied in one place for both callers.

public module namo {
  using sun;

  // History lines carrying a known credential prefix are dropped entirely
  // rather than partially masked; the rest is trimmed to the most recent
  // `keep` commands.
  public function parse_history(alloc: ref HeapAllocator, raw: const ref String, keep: i64) Vec<String> {
    var out = Vec<String>(alloc, 16);
    if (keep <= 0) {
      return out;
    }
    var lines = split_lines(alloc, raw);

    var hist = Vec<String>(alloc, 16);
    for (var i: i64 = 0; i < lines.size(); i = i + 1) {
      var line = lines.get_unchecked(i);
      if (looks_secret(line) == false) {
        hist.push(line.clone(alloc));
      }
    }

    var start: i64 = 0;
    if (hist.size() > keep) {
      start = hist.size() - keep;
    }
    for (var j: i64 = start; j < hist.size(); j = j + 1) {
      out.push(hist.get_unchecked(j).clone(alloc));
    }
    return out;
  }
}
