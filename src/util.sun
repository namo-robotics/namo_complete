/** Provide checked string helpers and shared error results. */
public module namo {
  using std;

  /** Carries request, system, and checked-access failures to their handlers. */
  public enum AppResult<T> {
    Ok(T),
    Error(Error),
    OutOfBounds(IndexOutOfBoundsError),
    Json(JsonError),
    Tls(tls.TlsError)
  }

  /** Read a byte, returning NUL when the position is outside the string. */
  public function string_byte(value: const ref String, index: i64) u8 {
    return match value.at(index) {
      AccessResult.Ok(value) => value,
      (e: const ref IError) => 0
    };
  }

  /** Copy a byte range, returning an empty string for an invalid range. */
  public function string_slice(alloc: const ref HeapAllocator, value: const ref String, start: i64, count: i64) String {
    return match value.substr(alloc, start, count) {
      AccessResult.Ok(value) => value,
      (e: const ref IError) => String(alloc, "")
    };
  }

  public var CH_NL: u8 = 10;
  public var CH_SP: u8 = 32;
  public var CH_TAB: u8 = 9;
  public var CH_CR: u8 = 13;

  /** Split on '\n', dropping empty/whitespace-only lines. Trailing CR goes with
   * the surrounding whitespace. */
  public function split_lines(alloc: ref HeapAllocator, s: const ref String) AppResult<Vec<String>> {
    var out = Vec<String>(alloc, 8);
    var parts = s.split_nonempty(alloc, CH_NL);
    for (var i: i64 = 0; i < parts.size(); i = i + 1) {
      var line = (try clone_item(alloc, parts, i));
      line.trim();
      if (line.length() > 0) {
        out.push(line);
      }
    }
    return AppResult.Ok(out);
  }

  /** Copy a checked string element without extending the container borrow. */
  public function clone_item(alloc: const ref HeapAllocator, items: const ref Vec<String>, index: i64) AppResult<String> {
    var item = try items.get(index);
    return AppResult.Ok(item.clone(alloc));
  }
}
