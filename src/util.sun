// util.sun - string helpers with no stdlib equivalent: a line splitter that
// also drops blank lines, a cache-key hash, and the heuristics that judge what
// the model sent back. Everything else (trim, to_lower, contains, split,
// split_whitespace, join, clone, append_hex) lives on std.String.

public module namo {
  using std;

  public var CH_NL: u8 = 10;
  public var CH_SP: u8 = 32;
  public var CH_TAB: u8 = 9;
  public var CH_CR: u8 = 13;

  // Split on '\n', dropping empty/whitespace-only lines. Trailing CR goes with
  // the surrounding whitespace.
  public function split_lines(alloc: ref HeapAllocator, s: const ref String) Vec<String> {
    var out = Vec<String>(alloc, 8);
    var parts = s.split_nonempty(alloc, CH_NL);
    for (var i: i64 = 0; i < parts.size(); i = i + 1) {
      var line = parts.get_unchecked(i).clone(alloc);
      line.trim();
      if (line.length() > 0) {
        out.push(line);
      }
    }
    return out;
  }

  // Collapse whitespace runs to a single space; used for cache-key stability.
  public function normalize_ws(alloc: ref HeapAllocator, s: const ref String) String {
    var words = s.split_whitespace(alloc);
    return join(alloc, words, " ");
  }

  // Polynomial rolling hash, reduced each step so it cannot overflow i64.
  // This is a cache key, not a security primitive.
  public function hash_str(s: const ref String, seed: i64) i64 {
    var h: i64 = seed;
    for (var i: i64 = 0; i < s.length(); i = i + 1) {
      h = (h * 131 + s.at(i)) % 1000000007;
    }
    return h;
  }

  function is_alpha(c: u8) bool {
    if (c >= 97 and c <= 122) {
      return true;
    }
    return c >= 65 and c <= 90;
  }

  // Punctuation that is everywhere in shell syntax and almost nowhere in an
  // English sentence: - / = $ | * ~ ; > <
  function has_shell_punct(s: const ref String) bool {
    for (var i: i64 = 0; i < s.length(); i = i + 1) {
      var c: u8 = s.at(i);
      if (c == 45 or c == 47 or c == 61 or c == 36 or c == 124) {
        return true;
      }
      if (c == 42 or c == 126 or c == 59 or c == 62 or c == 60) {
        return true;
      }
    }
    return false;
  }

  // English function words. Two of them in a line that carries no shell
  // punctuation is what separates a sentence from a command.
  function is_stopword(w: const ref String) bool {
    if (w.equals_literal("the") or w.equals_literal("a") or w.equals_literal("an")) {
      return true;
    }
    if (w.equals_literal("is") or w.equals_literal("are") or w.equals_literal("was")) {
      return true;
    }
    if (w.equals_literal("to") or w.equals_literal("be") or w.equals_literal("of")) {
      return true;
    }
    if (w.equals_literal("it") or w.equals_literal("this") or w.equals_literal("that")) {
      return true;
    }
    if (w.equals_literal("not") or w.equals_literal("no") or w.equals_literal("any")) {
      return true;
    }
    if (w.equals_literal("does") or w.equals_literal("do") or w.equals_literal("can")) {
      return true;
    }
    if (w.equals_literal("i") or w.equals_literal("you") or w.equals_literal("your")) {
      return true;
    }
    if (w.equals_literal("there") or w.equals_literal("appear") or w.equals_literal("valid")) {
      return true;
    }
    return false;
  }

  // The sentences the model falls back on when it has nothing to offer.
  function sounds_like_refusal(low: const ref String) bool {
    if (low.contains("i cannot") or low.contains("i can't") or low.contains("i am unable")) {
      return true;
    }
    if (low.contains("i'm unable") or low.contains("unable to") or low.contains("i don't")) {
      return true;
    }
    if (low.contains("sorry") or low.contains("as an ai") or low.contains("no valid")) {
      return true;
    }
    if (low.contains("does not appear") or low.contains("there is no")) {
      return true;
    }
    if (low.contains("please provide") or low.contains("not a valid")) {
      return true;
    }
    return false;
  }

  // True when the line reads like something a shell could run. The model is told
  // to stay silent when it has nothing useful, but it sometimes answers with a
  // sentence instead ("I cannot produce a useful completion ..."). A sentence
  // in the hint row is worse than an empty row, so it is dropped here -- once,
  // before caching, so every caller sees the same filtered set.
  public function looks_like_command(alloc: ref HeapAllocator, cmd: const ref String) bool {
    if (cmd.length() == 0) {
      return false;
    }

    // Markdown fences and bullets, comments, list markers, quoted prose: a
    // command line never starts this way.
    var first: u8 = cmd.at(0);
    if (first == 35 or first == 96 or first == 42 or first == 45) {
      return false;
    }
    if (first == 124 or first == 62 or first == 60 or first == 91) {
      return false;
    }
    if (first == 34 or first == 39 or first == 63 or first == 33) {
      return false;
    }
    // Numbered list: "1) ls -la", "2. cd src".
    if (first >= 48 and first <= 57 and cmd.length() > 1) {
      var second: u8 = cmd.at(1);
      if (second == 41 or second == 46) {
        return false;
      }
    }

    // Sentence-ending punctuation. `git add .` and `cd ..` end in a dot too,
    // hence the letter test rather than a bare '.'.
    var last: u8 = cmd.at(cmd.length() - 1);
    if (last == 63 or last == 33 or last == 58) {
      return false;
    }
    if (last == 46 and cmd.length() > 1) {
      if (is_alpha(cmd.at(cmd.length() - 2))) {
        return false;
      }
    }

    var low = cmd.clone(alloc);
    low.to_lower();
    if (sounds_like_refusal(low)) {
      return false;
    }

    // Anything else long and wordy: several English function words with none
    // of the punctuation a real command line carries.
    if (has_shell_punct(cmd) == false) {
      var words = low.split_whitespace(alloc);
      var stops: i64 = 0;
      for (var i: i64 = 0; i < words.size(); i = i + 1) {
        var w = words.get_unchecked(i);
        if (is_stopword(w)) {
          stops = stops + 1;
        }
      }
      if (words.size() >= 5 and stops >= 2) {
        return false;
      }
    }
    return true;
  }

  // A command one keystroke from running, in someone else's prompt. The shell
  // used to carry this list; it lives here so there is one copy of it, and so
  // the tests can reach it.
  public function looks_destructive(alloc: ref HeapAllocator, cmd: const ref String) bool {
    var low = cmd.clone(alloc);
    low.to_lower();
    low.trim();
    if (low.starts_with("sudo ")) {
      return true;
    }
    if (low.contains("rm -rf")) {
      return true;
    }
    if (low.contains("rm -fr")) {
      return true;
    }
    if (low.contains("mkfs")) {
      return true;
    }
    if (low.contains("dd if=")) {
      return true;
    }
    if (low.contains("> /dev/")) {
      return true;
    }
    if (low.contains("| sh")) {
      return true;
    }
    if (low.contains("| bash")) {
      return true;
    }
    return false;
  }

  // What `history 1` prints, turned back into the line the user typed:
  //
  //     "  512  grpe -r TODO *.md"  ->  "grpe -r TODO *.md"
  //
  // The shell hands over the whole line rather than picking it apart itself,
  // along with the word the shell could not find and the words it would use if the
  // line was never recorded at all -- HISTCONTROL=ignorespace, HISTIGNORE and
  // `set +o history` all leave entry 1 belonging to some earlier command, and
  // the first word is what gives that away.
  public function history_line(alloc: ref HeapAllocator, raw: const ref String, word: const ref String, fallback: const ref String) String {
    var line = raw.clone(alloc);
    line.trim();

    var i: i64 = 0;
    while (i < line.length() and line.at(i) >= 48 and line.at(i) <= 57) {
      i = i + 1;
    }
    var typed = line.substr(alloc, i, line.length() - i);
    typed.trim();

    var words = typed.split_whitespace(alloc);
    if (words.size() == 0 or words.get_unchecked(0).equals(word) == false) {
      return fallback.clone(alloc);
    }
    return typed;
  }

  // True when the line carries a known credential prefix. Only these are
  // matched: keyword heuristics ("password", "token", `export `) dropped far
  // too much ordinary history to be worth the recall.
  public function looks_secret(line: const ref String) bool {
    if (line.contains("sk-") or line.contains("ghp_")) {
      return true;
    }
    if (line.contains("github_pat_") or line.contains("AKIA")) {
      return true;
    }
    if (line.contains("xoxb-") or line.contains("xoxp-")) {
      return true;
    }
    return false;
  }
}
