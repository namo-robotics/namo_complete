// util.sun - the few string helpers the stdlib still does not provide.
//
// Everything else (trim, to_lower, contains, split, clone, append_hex) now
// lives on sun.String; see SUN_FEEDBACK.md §10.

public module namo {
  using sun;

  public var CH_NL: u8 = 10;
  public var CH_SP: u8 = 32;
  public var CH_TAB: u8 = 9;
  public var CH_CR: u8 = 13;

  public function is_space(c: u8) bool {
    return c == CH_SP or c == CH_TAB or c == CH_NL or c == CH_CR;
  }

  // Split on '\n', dropping empty/whitespace-only lines. Trailing CR goes with
  // the surrounding whitespace.
  public function split_lines(alloc: ref HeapAllocator, s: ref String) Vec<String> {
    var out = Vec<String>(alloc, 8);
    var parts = s.split(alloc, CH_NL);
    for (var i: i64 = 0; i < parts.size(); i = i + 1) {
      var line = parts.get_unchecked(i).clone(alloc);
      line.trim();
      if (line.length() > 0) {
        out.push(line);
      }
    }
    return out;
  }

  // Collapse whitespace runs to a single space; used for cache-key stability.
  public function normalize_ws(alloc: ref HeapAllocator, s: ref String) String {
    var out = String(alloc, "");
    var prev_space: bool = false;
    for (var i: i64 = 0; i < s.length(); i = i + 1) {
      var c: u8 = s.at(i);
      if (is_space(c)) {
        if (prev_space == false and out.length() > 0) {
          out.append_char(CH_SP);
        }
        prev_space = true;
      } else {
        out.append_char(c);
        prev_space = false;
      }
    }
    out.trim();
    return out;
  }

  // Polynomial rolling hash, reduced each step so it cannot overflow i64.
  // This is a cache key, not a security primitive.
  public function hash_str(s: ref String, seed: i64) i64 {
    var h: i64 = seed;
    for (var i: i64 = 0; i < s.length(); i = i + 1) {
      h = (h * 131 + s.at(i)) % 1000000007;
    }
    return h;
  }

  // True when the line carries a known credential prefix. Only these are
  // matched: keyword heuristics ("password", "token", `export `) dropped far
  // too much ordinary history to be worth the recall.
  public function looks_secret(line: ref String) bool {
    if (line.contains("sk-") or line.contains("ghp_")) {
      return true;
    }
    if (line.contains("github_pat_") or line.contains("AKIA")) {
      return true;
    }
    if (line.contains("xoxb-") or line.contains("xoxp-")) {
      return true;
    }
    return false;
  }
}
