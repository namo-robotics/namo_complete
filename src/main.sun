// namo_complete - LLM-powered shell command completion.
//
// Reads the partial command line from the environment and the recent history
// from stdin, lists the working directory itself, asks Claude for completions,
// and writes the candidates to stdout one per line. The shell integration puts the chosen line
// into its editor buffer; nothing here ever executes a command.
//
// Any failure is silent on stdout so the shell prompt degrades gracefully.

using std;
using std.env;
using namo;

function emit(alloc: ref HeapAllocator, items: const ref Vec<String>) void {
  for (var i: i64 = 0; i < items.size(); i = i + 1) {
    println(items.get_unchecked(i));
  }
}

// Which build is this? The `dev` release is a rolling tag, so the version alone
// does not identify a binary; the commit it was built from does. Stamped by
// build.sh into src/version.sun.
function print_version(alloc: ref HeapAllocator) void {
  var line = String(alloc, "namo_complete ");
  line.append(VERSION);
  line.append(" (commit ");
  line.append(COMMIT);
  line.append(", built ");
  line.append(BUILT);
  line.append(")");
  println(line);
  var second = String(alloc, "built with ");
  second.append(BUILT_WITH);
  println(second);
}

function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 {
  var alloc = make_heap_allocator();
  var cfg = Config(alloc);

  // The only thing here that reads argv at all -- every setting comes from the
  // environment (see config.sun). Answered before the config, so that a shell
  // with NAMO_DISABLE=1 can still be asked what it has installed.
  var cli = cfg.environment.args(argc, argv);
  for (var i: i64 = 1; i < cli.size(); i = i + 1) {
    var arg = cli.get_unchecked(i);
    if (arg.equals_literal("--version") or arg.equals_literal("-V")) {
      print_version(alloc);
      return 0;
    }
  }

  if (cfg.disabled) {
    return 0;
  }

  // Hints as you type: fork off the daemon and give the shell its prompt back.
  // See
  // daemon.sun for why none of that work can happen in the shell itself.
  if (cfg.daemon) {
    return daemon_run(alloc, cfg);
  }

  // Output capture: the shell's stdout on the other side of a pty. See
  // cmd_output_relay.sun for why it is a pty and not a pipe.
  if (cfg.relay) {
    return relay_run(alloc, cfg);
  }

  // Too little to go on: not worth a round trip. A borrow, not an assignment:
  // `var subject = cfg.query` would move the String out of the Config, leaving
  // the field empty for build_context later.
  var subject: const ref String = cfg.from_query() ? cfg.query : cfg.line;
  var prefix = subject.clone(alloc);
  prefix.trim();
  if (prefix.length() < 3) {
    return 0;
  }

  var key = cache_key(alloc, cfg);
  if (cfg.use_cache) {
    var hit = cache_lookup(alloc, cfg, key);
    if (hit.size() > 0) {
      emit(alloc, hit);
      return 0;
    }
  }

  // Cache-only mode is asked for a line at a time and must never block on the
  // network: serve from cache or return nothing at all.
  if (cfg.cache_only) {
    return 0;
  }

  if (cfg.api_key.length() == 0) {
    eprint("[namo] ANTHROPIC_API_KEY is not set\n");
    return 1;
  }

  if (cfg.min_gap > 0 and rate_limit_ok(alloc, cfg, cfg.min_gap) == false) {
    return 0;
  }

  // History arrives on stdin: `fc` is a shell builtin, so the shell is the
  // only thing that can read its own history. The directory listing is ours
  // to take -- same code the daemon uses, so both paths send the same
  // context for the same directory.
  var raw_stdin = read_fd(alloc, 0);
  var history = parse_history(alloc, raw_stdin, cfg.history_lines);

  var listing = String(alloc, "");
  if (cfg.send_ls) {
    listing = list_dir(alloc, cfg.cwd, cfg.ls_limit);
  }

  var context = build_context(alloc, cfg, history, listing);
  var body = build_body(alloc, cfg, context);

  var reply = Reply(alloc);
  try {
    reply = call_api(alloc, cfg, body);
  } catch (e: IError) {
    eprint("[namo] request failed\n");
    return 1;
  }

  if (reply.failed) {
    return 1;
  }
  if (reply.suggestions.size() == 0) {
    return 0;
  }

  cache_store(alloc, cfg, key, reply.suggestions);
  emit(alloc, reply.suggestions);
  return 0;
}

manifest {
    source_files: [
        "version.sun",
        "util.sun",
        "fs.sun",
        "config.sun",
        "prompt.sun",
        "redact.sun",
        "client.sun",
        "cache.sun",
        "daemon.sun",
        "cmd_output_relay.sun"
    ]
    libraries: ["stdlib.moon", "tls.moon"]
    target: {
        linux: { source_files: ["platform_linux.sun"] }
        macos: { source_files: ["platform_macos.sun"] }
    }
}
