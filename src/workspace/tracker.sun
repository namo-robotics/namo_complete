/** Track Bash's editable line from displayed output without intercepting typing. */
public module namo {
  using std;
  var MARK_START: u8 = 30;
  var MARK_FLUSH: u8 = 31;
  var MARK_PROMPT: u8 = 29;
  var MAX_LINE: i64 = 400;

  var TRK_TEXT: i32 = 0;
  var TRK_ESC: i32 = 1;
  var TRK_CSI: i32 = 2;

  /** Tracks the editable command line observed in the terminal byte stream. */
  public class Tracker {
    public var line: String;
    public var point: i64;  // in bytes, which is why `wide` exists
    public var armed: bool;  // between the prompt marker and the newline
    public var wide: bool;  // a byte >= 0x80 went by: bytes and columns
    // no longer agree, so the next cursor move
    // would be guesswork
    public var dirty: bool;  // changed since the last record went out
    public var ended: bool;  // Enter went by, or a command started
    public var state: i32;
    public var param: i64;
    public var got_param: bool;
    public var known: bool;  // this CSI is one of the six we follow

    /** Initialize an empty observed edit buffer. */
    init(alloc: ref HeapAllocator) {
      this.line = String(alloc, "");
      this.point = 0;
      this.armed = false;
      this.wide = false;
      this.dirty = false;
      this.ended = false;
      this.state = TRK_TEXT;
      this.param = 0;
      this.got_param = false;
      this.known = true;
    }
  }

  function trk_reset(alloc: ref HeapAllocator, t: ref Tracker, armed: bool) void {
    t.line = String(alloc, "");
    t.point = 0;
    t.armed = armed;
    t.wide = false;
    t.dirty = armed;
    t.ended = false;
    t.state = TRK_TEXT;
  }

  // Readline opens a gap with ESC[n@ before it writes into the middle of a
  // line, so a character always lands on a column that is already there.
  function trk_put(alloc: ref HeapAllocator, t: ref Tracker, c: u8) void {
    if (t.point < t.line.length()) {
      match t.line.set_at(t.point, c) {
        (e: const ref IError) => {
          return;
        },
        _ => {}
      };
    } else {
      t.line.append_char(c);
    }
    t.point = t.point + 1;
    t.dirty = true;
  }

  function trk_splice(alloc: ref HeapAllocator, t: ref Tracker, insert: i64, drop: i64) void {
    var out = String(alloc, "");
    for (var i: i64 = 0; i < t.point and i < t.line.length(); i = i + 1) {
      out.append_char(string_byte(t.line, i));
    }
    for (var g: i64 = 0; g < insert; g = g + 1) {
      out.append_char(CH_SP);
    }
    for (var j: i64 = t.point + drop; j < t.line.length(); j = j + 1) {
      out.append_char(string_byte(t.line, j));
    }
    t.line = out;
    t.dirty = true;
  }

  function trk_csi(alloc: ref HeapAllocator, t: ref Tracker, fin: u8) void {
    var n: i64 = 1;
    if (t.got_param and t.param > 0) {
      n = t.param;
    }
    if (t.known == false) {
      t.armed = false;
      return;
    }
    if (fin == 75) {
      // K: erase to the end of the row
      t.line.truncate(t.point);
      t.dirty = true;
    } else if (fin == 64) {
      // @: open a gap of n
      trk_splice(alloc, t, n, 0);
    } else if (fin == 80) {
      // P: close a gap of n
      trk_splice(alloc, t, 0, n);
    } else if (fin == 67) {
      // C: right
      t.point = t.point + n;
      if (t.point > t.line.length()) {
        t.point = t.line.length();
      }
    } else if (fin == 68) {
      // D: left
      t.point = t.point - n;
      if (t.point < 0) {
        t.point = 0;
      }
    } else if (fin == 109) {
      // m: colour, and none of our business
      var ignored: bool = true;
    } else {
      t.armed = false;
    }
    if (t.wide and (fin == 64 or fin == 80 or fin == 67 or fin == 68)) {
      t.armed = false;
    }
  }

  function trk_feed(alloc: ref HeapAllocator, t: ref Tracker, c: u8) void {
    if (t.state == TRK_ESC) {
      if (c == 91) {
        // ESC [
        t.state = TRK_CSI;
        t.param = 0;
        t.got_param = false;
        t.known = true;
      } else {
        t.state = TRK_TEXT;
        t.armed = false;
      }
      return;
    }
    if (t.state == TRK_CSI) {
      if (c >= 48 and c <= 57) {
        // 0-9
        t.param = t.param * 10 + _convert<i64>(c - 48);
        t.got_param = true;
        return;
      }
      if (c >= 32 and c <= 63) {
        // ';' '?' and the intermediates
        t.known = false;
        return;
      }
      if (c >= 64 and c <= 126) {
        // the final byte
        t.state = TRK_TEXT;
        trk_csi(alloc, t, c);
        return;
      }
      t.state = TRK_TEXT;
      t.armed = false;
      return;
    }

    // A prompt has just finished printing: whatever follows is the line.
    if (c == MARK_PROMPT) {
      trk_reset(alloc, t, true);
      return;
    }
    if (c == 27) {
      t.state = TRK_ESC;
      return;
    }
    // Enter, or a command starting. Either way the line is no longer ours.
    if (c == 10 or c == MARK_START) {
      t.armed = false;
      t.ended = true;
      return;
    }
    if (t.armed == false) {
      return;
    }
    if (c == 13) {
      // A repaint from column 0. The prompt that comes with it re-arms us --
      // and if it is a prompt of readline's own, like reverse search, nothing
      // does, which is the answer we want.
      t.armed = false;
      return;
    }
    if (c == 8) {
      // BS: one column left
      if (t.wide) {
        t.armed = false;
        return;
      }
      if (t.point > 0) {
        t.point = t.point - 1;
      }
      return;
    }
    if (c == 7 or c == 9 or c == MARK_FLUSH) {
      return;  // bell, tab, end of a recording
    }
    if (c < 32 or c == 127) {
      t.armed = false;
      return;
    }
    if (c >= 128) {
      t.wide = true;
    }
    trk_put(alloc, t, c);
  }
}
