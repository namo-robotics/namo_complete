// config.sun - runtime configuration, entirely from the environment.
//
// Input arrives via environment variables rather than argv: bash `export`
// handles arbitrary bytes with no quoting concerns, and the values we need
// (READLINE_LINE, PWD) are already shell variables.

public module namo {
  using sun;
  using sun.env;
  using sun.process;

  public class Config {
    public var line: String;
    public var query: String;
    public var mode: String;
    public var cwd: String;
    public var model: String;
    public var api_key: String;
    public var endpoint: String;
    public var runtime_dir: String;
    public var cache_dir: String;
    public var history_lines: i64;
    public var max_suggestions: i64;
    public var cache_ttl: i64;
    public var ls_limit: i64;
    public var hint_min: i64;
    public var min_gap: i64;
    public var use_cache: bool;
    public var send_ls: bool;
    public var disabled: bool;
    public var cache_only: bool;

    // Live-hint daemon (see live.sun). Empty paths mean "not launched by the
    // shell integration", which is the normal state for a one-shot run.
    public var daemon: bool;
    public var fifo: String;
    public var reply: String;
    public var histfile: String;
    public var pidfile: String;
    public var tty_path: String;
    public var hint_prefix: String;
    public var hint_suffix: String;
    public var dym_prefix: String;
    public var debounce_ms: i64;
    public var quiet_ms: i64;

    public function init(alloc: ref HeapAllocator) {
      this.line = env_str(alloc, "NAMO_LINE");
      this.query = env_str(alloc, "NAMO_QUERY");
      this.mode = env_or(alloc, "NAMO_MODE", "complete");
      this.cwd = env_or(alloc, "NAMO_CWD", ".");
      this.model = env_or(alloc, "NAMO_MODEL", "claude-haiku-4-5");
      this.api_key = env_str(alloc, "ANTHROPIC_API_KEY");
      this.endpoint = env_or(
        alloc,
        "NAMO_ENDPOINT",
        "https://api.anthropic.com/v1/messages"
      );

      this.history_lines = env_int(alloc, "NAMO_HISTORY_LINES", 50);
      this.ls_limit = env_int(alloc, "NAMO_LS_LIMIT", 40);
      this.hint_min = env_int(alloc, "NAMO_HINT_MIN", 3);
      this.max_suggestions = env_int(alloc, "NAMO_MAX_SUGGESTIONS", 3);
      this.cache_ttl = env_int(alloc, "NAMO_CACHE_TTL", 900);
      this.min_gap = env_int(alloc, "NAMO_MIN_GAP", 1);
      this.use_cache = env_int(alloc, "NAMO_CACHE", 1) != 0;
      this.send_ls = env_int(alloc, "NAMO_NO_LS", 0) == 0;
      this.disabled = env_int(alloc, "NAMO_DISABLE", 0) != 0;
      this.cache_only = env_int(alloc, "NAMO_CACHE_ONLY", 0) != 0;

      this.daemon = env_int(alloc, "NAMO_DAEMON", 0) != 0;
      this.fifo = env_str(alloc, "NAMO_FIFO");
      // Where answers to the shell's own requests go back. See live.sun.
      this.reply = env_str(alloc, "NAMO_REPLY");
      this.histfile = env_str(alloc, "NAMO_HISTFILE");
      this.pidfile = env_str(alloc, "NAMO_PIDFILE");
      // Overridable so the test suite can watch what would have been drawn.
      this.tty_path = env_or(alloc, "NAMO_TTY", "/dev/tty");
      this.hint_prefix = env_or(alloc, "NAMO_HINT_PREFIX", "hint: ");
      this.hint_suffix = env_or(alloc, "NAMO_HINT_SUFFIX", "  (Alt-O / Alt-A for more)");
      // The correction row carries no suffix: Alt-O runs a completion, and
      // offering it next to a line that is not one would be a lie.
      this.dym_prefix = env_or(alloc, "NAMO_DYM_PREFIX", "did you mean: ");
      // Documented in seconds, used in milliseconds by poll(2).
      this.debounce_ms = env_ms(alloc, "NAMO_DEBOUNCE", 200);
      this.quiet_ms = env_ms(alloc, "NAMO_QUIET", 50);

      // Runtime dir holds the API key for the duration of one call, so it
      // must be user-private. XDG_RUNTIME_DIR is tmpfs mode 0700.
      var rt = env_str(alloc, "XDG_RUNTIME_DIR");
      if (rt.length() == 0) {
        rt = String(alloc, "/tmp/namo-");
        rt.append(uid());
      } else {
        rt.append("/namo_complete");
      }
      this.runtime_dir = rt;

      var cd = env_str(alloc, "XDG_CACHE_HOME");
      if (cd.length() == 0) {
        cd = env_or(alloc, "HOME", "/tmp");
        cd.append("/.cache/namo_complete");
      } else {
        cd.append("/namo_complete");
      }
      this.cache_dir = cd;
    }

    // Point the config at one line from the daemon's FIFO, so cache_key and
    // build_context -- both written against a one-shot run -- can be reused
    // unchanged for every keystroke.
    public function set_target(alloc: ref HeapAllocator, line: ref String, cwd: ref String) void {
      this.line = line.clone(alloc);
      this.cwd = cwd.clone(alloc);
    }

    // The daemon is one long-lived process answering every kind of request,
    // so anything that is not a keystroke borrows the config and hands it
    // back: set_query_target before the call, clear_query_target after it, and
    // the keystrokes that follow are served exactly as before.
    public function set_query_target(alloc: ref HeapAllocator, mode: static_ptr<u8>, query: ref String, cwd: ref String) void {
      this.mode = String(alloc, mode);
      this.query = query.clone(alloc);
      this.cwd = cwd.clone(alloc);
    }

    public function clear_query_target(alloc: ref HeapAllocator) void {
      this.mode = String(alloc, "complete");
      this.query = String(alloc, "");
    }

    public function is_ask() bool {
      return this.mode.equals_literal("ask");
    }

    // "Did you mean": bash could not find the command, and the line the user
    // typed arrives in NAMO_QUERY to be corrected rather than completed.
    public function is_dym() bool {
      return this.mode.equals_literal("dym");
    }

    // Both of the modes whose subject is NAMO_QUERY rather than NAMO_LINE.
    public function from_query() bool {
      return this.is_ask() or this.is_dym();
    }

    // Path inside the runtime dir.
    public function rt_path(alloc: ref HeapAllocator, name: static_ptr<u8>) String {
      var p = String(alloc, "");
      p.append(this.runtime_dir);
      p.append("/");
      p.append(name);
      return p;
    }
  }

  // sun.env.get returns an Option; almost everything here wants "" for unset,
  // and the two callers that do not use env_or.
  public function env_str(alloc: ref HeapAllocator, name: raw_ptr<u8>) String {
    return match sun.env.get(alloc, name) {
      Option.Some(v) => v,
      Option.None => String(alloc, "")
    };
  }

  public function env_or(alloc: ref HeapAllocator, name: raw_ptr<u8>, fallback: static_ptr<u8>) String {
    var v = env_str(alloc, name);
    if (v.length() == 0) {
      return String(alloc, fallback);
    }
    return v;
  }

  // Seconds as a decimal ("0.2", ".05", "1") to whole milliseconds. Anything
  // that is not a plain decimal number falls back rather than half-parsing.
  public function env_ms(alloc: ref HeapAllocator, name: raw_ptr<u8>, fallback: i64) i64 {
    var raw = env_str(alloc, name);
    raw.trim();
    if (raw.length() == 0) {
      return fallback;
    }
    var whole: i64 = 0;
    var frac: i64 = 0;
    var scale: i64 = 100;
    var seen_dot: bool = false;
    var seen_digit: bool = false;
    for (var i: i64 = 0; i < raw.length(); i = i + 1) {
      var c: u8 = raw.at(i);
      if (c == 46) {
        if (seen_dot) {
          return fallback;
        }
        seen_dot = true;
      } else {
        if (c < 48 or c > 57) {
          return fallback;
        }
        seen_digit = true;
        var d: i64 = c;
        d = d - 48;
        if (seen_dot) {
          if (scale > 0) {
            frac = frac + d * scale;
            scale = scale / 10;
          }
        } else {
          whole = whole * 10 + d;
        }
      }
    }
    if (seen_digit == false) {
      return fallback;
    }
    return whole * 1000 + frac;
  }

  public function env_int(alloc: ref HeapAllocator, name: raw_ptr<u8>, fallback: i64) i64 {
    var raw = env_str(alloc, name);
    if (raw.length() == 0) {
      return fallback;
    }
    var parsed = raw.parse_i64();
    return match parsed {
      Option.Some(v) => v,
      Option.None => fallback
    };
  }
}
