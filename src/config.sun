/** Read workspace settings from the environment. */
public module namo {
  using std;
  using std.env;
  using std.process;

  /** Hold runtime settings captured from the process environment. */
  public class Config {
    public var environment: Env;
    // Shell syntax used for model context.
    public var shell_name: String;
    public var model: String;
    public var api_key: String;
    public var endpoint: String;
    public var history_lines: i64;
    public var ls_limit: i64;
    public var hint_min: i64;
    public var send_ls: bool;
    public var disabled: bool;

    public var output_lines: i64;
    public var debounce_ms: i64;

    /** Read workspace settings from the environment. */
    init(alloc: ref HeapAllocator) {
      this.environment = Env(alloc);
      this.shell_name = env_or(alloc, this.environment, "NAMO_SHELL", "shell");
      this.model = env_or(alloc, this.environment, "NAMO_MODEL", "claude-opus-5");
      this.api_key = env_str(alloc, this.environment, "ANTHROPIC_API_KEY");
      this.endpoint = env_or(
        alloc,
        this.environment,
        "NAMO_ENDPOINT",
        "https://api.anthropic.com/v1/messages"
      );

      this.history_lines = env_int(alloc, this.environment, "NAMO_HISTORY_LINES", 50);
      this.ls_limit = env_int(alloc, this.environment, "NAMO_LS_LIMIT", 40);
      this.hint_min = env_int(alloc, this.environment, "NAMO_HINT_MIN", 3);
      this.send_ls = env_int(alloc, this.environment, "NAMO_NO_LS", 0) == 0;
      this.disabled = env_int(alloc, this.environment, "NAMO_DISABLE", 0) != 0;

      this.output_lines = env_int(alloc, this.environment, "NAMO_OUTPUT", 10);
      this.debounce_ms = env_ms(alloc, this.environment, "NAMO_DEBOUNCE", 200);
    }
  }

  // Env.get returns an Option; almost everything here wants "" for unset,
  // and the two callers that do not use env_or.
  public function env_str(alloc: ref HeapAllocator, environment: ref Env, name: static_ptr<u8>) String {
    var out = String(alloc, "");
    match environment.get(name) {
      Option.Some(v) => out.append(v),
      Option.None => {}
    };
    return out;
  }

  // Read an environment variable, using a fallback when it is unset.
  public function env_or(alloc: ref HeapAllocator, environment: ref Env, name: static_ptr<u8>, fallback: static_ptr<u8>) String {
    var v = env_str(alloc, environment, name);
    if (v.length() == 0) {
      return String(alloc, fallback);
    }
    return v;
  }

  // Seconds as a decimal ("0.2", ".05", "1") to whole milliseconds. Anything
  // that is not a plain decimal number falls back rather than half-parsing.
  public function env_ms(alloc: ref HeapAllocator, environment: ref Env, name: static_ptr<u8>, fallback: i64) i64 {
    var raw = env_str(alloc, environment, name);
    raw.trim();
    if (raw.length() == 0) {
      return fallback;
    }
    var whole: i64 = 0;
    var frac: i64 = 0;
    var scale: i64 = 100;
    var seen_dot: bool = false;
    var seen_digit: bool = false;
    for (var i: i64 = 0; i < raw.length(); i = i + 1) {
      var c: u8 = string_byte(raw, i);
      if (c == 46) {
        if (seen_dot) {
          return fallback;
        }
        seen_dot = true;
      } else {
        if (c < 48 or c > 57) {
          return fallback;
        }
        seen_digit = true;
        var d: i64 = c;
        d = d - 48;
        if (seen_dot) {
          if (scale > 0) {
            frac = frac + d * scale;
            scale = scale / 10;
          }
        } else {
          whole = whole * 10 + d;
        }
      }
    }
    if (seen_digit == false) {
      return fallback;
    }
    return whole * 1000 + frac;
  }

  // Read a decimal environment variable, using a fallback when invalid.
  public function env_int(alloc: ref HeapAllocator, environment: ref Env, name: static_ptr<u8>, fallback: i64) i64 {
    var raw = env_str(alloc, environment, name);
    if (raw.length() == 0) {
      return fallback;
    }
    var parsed = raw.parse_i64();
    return match parsed {
      Option.Some(v) => v,
      Option.None => fallback
    };
  }
}
