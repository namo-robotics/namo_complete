// daemon.sun - the as-you-type hint daemon.
//
// Records arrive as "<cwd>\t<line>", one write() into a FIFO, and everything
// that debounces, reads a cache, calls the API or paints the screen happens
// over here, in a process forked once per shell. Nothing in the shell is on
// the keystroke path at all any more: the relay watches the line go past on
// the shell's own stdout and posts it here (cmd_output_relay.sun), with the cwd field
// empty for the last one the shell reported at a prompt to fill.
//
// Bash requires that split. It blanks the prompt line before running
// a `bind -x` command and repaints it in full afterwards, so a handler on every
// printable key is a repaint on every character -- flicker on a terminal that
// draws as the bytes arrive -- and however long that handler takes is a hole
// in the line being typed into.
//
// Started with NAMO_DAEMON=1 and the FIFO path in NAMO_FIFO. Exits when the
// FIFO reports end-of-input, which is what happens when the shell holding the
// write end goes away.

/** Serve interactive hints and synchronous completion requests. */
public module namo {
  using std;
  using std.io;
  using std.process;

  var REC_OK: i32 = 0;
  var REC_TIMEOUT: i32 = 1;
  var REC_EOF: i32 = 2;

  // A correction request rides the same FIFO as every keystroke, marked with
  // a leading SOH on the line field: readline cannot put a 0x01 at the start
  // of a buffer (Ctrl-A is a binding, not a character), so no line the user
  // can type is mistaken for one. See namo_complete.bash.
  var DYM_MARK: u8 = 1;
  // ETX is sent by the shell exit hook, avoiding platform-specific FIFO EOF.
  var STOP_MARK: u8 = 3;

  // And STX marks a request the shell is *waiting* for -- Alt-O, Alt-A,
  // Alt-G. Same FIFO, same reason: a key press must not fork either, so the
  // shell asks the daemon and reads the answer back down a second FIFO
  // instead of starting a copy of this binary per keystroke.
  //
  //   <cwd> TAB STX <id> TAB <mode> TAB <line>      request
  //   <id> TAB <count>                              reply header
  //   <id> TAB E TAB <message>                      failed request
  //   <id> TAB <candidate>                          ...that many times
  //
  // The id is echoed on every line so that an answer the shell has already
  // given up waiting for is recognised and dropped rather than mistaken for
  // the next one. `mode` is "c" to complete a line or "a" to answer a
  // question.
  var SYNC_MARK: u8 = 2;

  var FIFO_BUF: i64 = 4096;
  var TABLE_MAX: i64 = 256;
  // How much of a failure message the row will carry. API messages can run to
  // a paragraph; the row is one line under a prompt of unknown width.
  var ERR_MAX: i64 = 120;
  // Nothing the shell had open is of any use to us; see daemon_run.
  var MAX_INHERITED_FD: i32 = 256;

  /** Holds the long-lived state used by the interactive hint daemon. */
  public class Daemon {
    // The terminal we draw the hint row on, and the pipe the shell types
    // into. Both are owned here: closing them is what ends the daemon.
    public var tty: File;
    public var fifo: File;
    // Rearmed before every wait. One descriptor, but Poller is what keeps
    // struct pollfd out of this file.
    public var poller: Poller;
    // Bytes read from the FIFO that do not yet make up a whole record.
    public var pending: String;
    // What the hint row is showing right now. Repainting the row with what it
    // already shows is a visible blink of its own, so an unchanged hint costs
    // nothing.
    public var screen: String;
    // Newest hint, kept while it still extends the typed line.
    public var last: String;
    // line -> hint, so a keystroke that lands on a line we have already
    // answered repaints without touching the disk.
    public var keys: Vec<String>;
    public var vals: Vec<String>;
    // Allocated once: this loop runs on every keystroke for the life of the
    // shell, so the buffer it needs is not built per call.
    public var chunk: ContiguousBuffer<u8>;
    // Opened on the first request the shell waits for, and held open after
    // that. Opening a FIFO for writing blocks until it has a reader, and the
    // shell is that reader for exactly as long as it is waiting -- so it is
    // opened at the one moment it is certain not to block.
    public var reply: File;
    public var reply_open: bool;
    // The directory the shell was in at the last prompt. Records that come
    // from the relay carry the line and nothing else -- it watches a pty, not
    // a shell, and has no business guessing where that shell is -- so this is
    // what fills the field in for them.
    public var last_cwd: String;
    // Why the last paid call failed, or empty if it did not. Set by
    // daemon_call, cleared by the next call that works, and drawn by render
    // in place of the hint -- the daemon has no stderr anyone can read.
    public var err: String;

    init(alloc: ref HeapAllocator) {
      this.tty = File();
      this.fifo = File();
      this.poller = Poller(alloc);
      this.pending = String(alloc, "");
      this.screen = String(alloc, "");
      this.last = String(alloc, "");
      this.keys = Vec<String>(alloc, 32);
      this.vals = Vec<String>(alloc, 32);
      this.chunk = ContiguousBuffer<u8>(alloc, FIFO_BUF);
      this.reply = File();
      this.last_cwd = String(alloc, "");
      this.err = String(alloc, "");
      this.reply_open = false;
    }
  }

  // ------------------------------------------------------------------------
  // Hint table
  // ------------------------------------------------------------------------

  function table_find(st: const ref Daemon, line: const ref String) AppResult<i64> {
    for (var i: i64 = 0; i < st.keys.size(); i = i + 1) {
      if ((try st.keys.get(i)).equals(line)) {
        return AppResult.Ok(i);
      }
    }
    return AppResult.Ok(-1);
  }

  function table_put(alloc: ref HeapAllocator, st: ref Daemon, line: const ref String, hint: const ref String) AppResult<void> {
    var at = (try table_find(st, line));
    if (at >= 0) {
      try st.vals.set(at, hint.clone(alloc));
      return AppResult.Ok;
    }
    if (st.keys.size() >= TABLE_MAX) {
      st.keys.clear();
      st.vals.clear();
    }
    st.keys.push(line.clone(alloc));
    st.vals.push(hint.clone(alloc));

    return AppResult.Ok;
  }

  // ------------------------------------------------------------------------
  // Terminal
  // ------------------------------------------------------------------------

  // One row below the cursor -- the row the prompt hook reserves, so this is
  // the row under the line being typed, wherever on the screen that is.
  //
  // It used to be the last row of the screen (ESC[999;1H), which is the line
  // being typed into as soon as the prompt reaches the bottom of the screen,
  // which is most of the time. Relative positioning cannot do that, and it
  // still emits no newline: a newline at the bottom would scroll the screen
  // and leave the saved cursor pointing a row too low.
  function paint(alloc: ref HeapAllocator, st: ref Daemon, row: const ref String) void {
    if (st.screen.equals(row)) {
      return;
    }
    var esc = String(alloc, "");
    esc.append_char(27);
    esc.append("7");
    esc.append_char(27);
    esc.append("[1B");
    esc.append_char(13);
    esc.append_char(27);
    esc.append("[2K");
    if (row.length() > 0) {
      esc.append_char(27);
      esc.append("[2m");
      esc.append(row);
      esc.append_char(27);
      esc.append("[0m");
    }
    esc.append_char(27);
    esc.append("8");
    var written: i64 = st.tty.write(esc);
    st.screen = row.clone(alloc);
  }

  function clear_row(alloc: ref HeapAllocator, st: ref Daemon) void {
    var blank = String(alloc, "");
    paint(alloc, st, blank);
  }

  // Decide what the row should show for `line` and put it there. Reads only
  // the in-memory table, so this is safe to run on every single keystroke.
  function render(alloc: ref HeapAllocator, cfg: const ref Config, st: ref Daemon, line: const ref String) AppResult<void> {
    if (line.length() < cfg.hint_min) {
      st.last = String(alloc, "");
      clear_row(alloc, st);
      return AppResult.Ok;
    }

    // A failure outranks the hint table. Whatever is cached there was true
    // before the API started refusing, and leaving it up while every new
    // keystroke fails is how a broken model name stays invisible for a week.
    if (st.err.length() > 0) {
      var erow = String(alloc, "");
      erow.append(cfg.err_prefix);
      erow.append(st.err);
      // One row, and it is drawn under a prompt of unknown width.
      if (erow.length() > ERR_MAX) {
        erow.truncate(ERR_MAX);
        erow.append("...");
      }
      paint(alloc, st, erow);
      return AppResult.Ok;
    }

    var hint = String(alloc, "");
    var at = (try table_find(st, line));
    if (at >= 0) {
      hint = (try clone_item(alloc, st.vals, at));
    } else {
      // A hint the user is typing straight into stays up instead of blinking
      // off and back on with every character that confirms it.
      if (st.last.length() > 0 and st.last.starts_with(line)) {
        hint = st.last.clone(alloc);
      }
    }

    if (hint.length() > 0 and hint.equals(line) == false) {
      var row = String(alloc, "");
      row.append(cfg.hint_prefix);
      row.append(hint);
      row.append(cfg.hint_suffix);
      paint(alloc, st, row);
    } else {
      clear_row(alloc, st);
    }

    return AppResult.Ok;
  }

  // ------------------------------------------------------------------------
  // Directory listing
  // ------------------------------------------------------------------------

  /** `ls -1A | head` without the fork, over the directory the line was typed in
   * rather than the one this process happens to be sitting in. Sorted, so the
   * context the model sees does not depend on directory order. */
  public function list_dir(alloc: ref HeapAllocator, path: ref String, limit: i64) AppResult<String> {
    var out = String(alloc, "");
    var names = Vec<DirEntry>(alloc, 8);
    match read_dir(alloc, path) {
      SystemResult.Ok(value) => {
        names = value;
      },
      (e: const ref IError) => {
        return AppResult.Ok(out);
      }
    };

    var want: i64 = names.size();
    if (limit > 0 and want > limit) {
      want = limit;
    }

    // Selection sort, stopped at `want`: taking the first N of a sorted
    // listing costs N passes, not a full sort of a directory that may hold
    // thousands of entries.
    var used = ContiguousBuffer<u8>(alloc, names.size() + 1);
    for (var u: i64 = 0; u < names.size(); u = u + 1) {
      try used.set(u, 0);
    }

    for (var picked: i64 = 0; picked < want; picked = picked + 1) {
      var best: i64 = -1;
      for (var j: i64 = 0; j < names.size(); j = j + 1) {
        if ((try used.get(j)) == 0) {
          if (best < 0) {
            best = j;
          } else {
            var cand = (try clone_entry_name(alloc, names, j));
            var held = (try names.get(best)).name();
            if (cand.compare(held) < 0) {
              best = j;
            }
          }
        }
      }
      if (best < 0) {
        picked = want;
      } else {
        try used.set(best, 1);
        // The listing rides inline in the prompt, so it is bounded by bytes
        // as well as by count.
        if (out.length() < 512) {
          if (out.length() > 0) {
            out.append(" ");
          }
          out.append((try names.get(best)).name());
        }
      }
    }
    return AppResult.Ok(out);
  }

  // ------------------------------------------------------------------------
  // FIFO records: "<cwd>\t<line>\n"
  // ------------------------------------------------------------------------

  function rec_cwd(alloc: ref HeapAllocator, rec: const ref String) String {
    var out = String(alloc, "");
    var found = rec.find_char(CH_TAB);
    var idx: i64 = match found {
      Option.Some(v) => v,
      Option.None => -1
    };
    if (idx < 0) {
      return out;
    }
    for (var i: i64 = 0; i < idx; i = i + 1) {
      out.append_char(string_byte(rec, i));
    }
    return out;
  }

  function rec_line(alloc: ref HeapAllocator, rec: const ref String) String {
    var out = String(alloc, "");
    var found = rec.find_char(CH_TAB);
    var idx: i64 = match found {
      Option.Some(v) => v,
      Option.None => -1
    };
    if (idx < 0) {
      return out;
    }
    for (var i: i64 = idx + 1; i < rec.length(); i = i + 1) {
      out.append_char(string_byte(rec, i));
    }
    return out;
  }

  function rec_mark(alloc: ref HeapAllocator, rec: const ref String, mark: u8) bool {
    var line = rec_line(alloc, rec);
    if (line.length() == 0) {
      return false;
    }
    return string_byte(line, 0) == mark;
  }

  function rec_is_sync(alloc: ref HeapAllocator, rec: const ref String) bool {
    return rec_mark(alloc, rec, SYNC_MARK);
  }

  function rec_is_stop(alloc: ref HeapAllocator, rec: const ref String) bool {
    return rec_mark(alloc, rec, STOP_MARK);
  }

  function rec_is_dym(alloc: ref HeapAllocator, rec: const ref String) bool {
    var line = rec_line(alloc, rec);
    if (line.length() == 0) {
      return false;
    }
    return string_byte(line, 0) == DYM_MARK;
  }

  // 1 when the FIFO has bytes, 0 on timeout, -1 once the write end is gone.
  function fifo_ready(st: ref Daemon, timeout_ms: i32) i32 {
    st.poller.clear();
    st.poller.add_read(st.fifo.get_fd());
    var ready: i32 = 0;
    match st.poller.wait(timeout_ms) {
      SystemResult.Ok(value) => {
        ready = value;
      },
      (e: const ref IError) => {
        // A signal cutting the wait short is not end-of-input; report it as a
        // timeout and let the caller decide. A wait that keeps failing ends the
        // daemon anyway, through the blocking call at the top of daemon_loop.
        return 0;
      }
    };
    if (ready <= 0) {
      return 0;
    }
    if (st.poller.is_readable(0)) {
      return 1;
    }
    // POLLHUP or POLLERR without POLLIN: nothing more is coming.
    return -1;
  }

  function take_record(alloc: ref HeapAllocator, st: ref Daemon, out: ref String) bool {
    var found = st.pending.find_char(CH_NL);
    var idx: i64 = match found {
      Option.Some(v) => v,
      Option.None => -1
    };
    if (idx < 0) {
      return false;
    }
    out.clear();
    for (var i: i64 = 0; i < idx; i = i + 1) {
      out.append_char(string_byte(st.pending, i));
    }
    var rest = String(alloc, "");
    for (var j: i64 = idx + 1; j < st.pending.length(); j = j + 1) {
      rest.append_char(string_byte(st.pending, j));
    }
    st.pending = rest;

    // "<cwd> TAB <line>" from the shell, "TAB <line>" from the relay. The
    // shell reports where it is at every prompt, which is the last moment it
    // could have moved, so an empty field is filled from that.
    if (out.length() > 0 and string_byte(out, 0) == CH_TAB) {
      var filled = st.last_cwd.clone(alloc);
      filled.append(out);
      out.clear();
      out.append(filled);
    } else {
      var seen = rec_cwd(alloc, out);
      if (seen.length() > 0) {
        st.last_cwd = seen.clone(alloc);
      }
    }
    return true;
  }

  // One record, or REC_TIMEOUT after `timeout_ms` (negative blocks forever),
  // or REC_EOF once the shell that owns the write end is gone.
  function next_record(alloc: ref HeapAllocator, st: ref Daemon, timeout_ms: i32, out: ref String) AppResult<i32> {
    var tries: i64 = 0;
    while (tries < 64) {
      tries = tries + 1;
      if (take_record(alloc, st, out)) {
        return AppResult.Ok(REC_OK);
      }
      var pr: i32 = fifo_ready(st, timeout_ms);
      if (pr == 0) {
        return AppResult.Ok(REC_TIMEOUT);
      }
      if (pr < 0) {
        return AppResult.Ok(REC_EOF);
      }
      var n: i64 = read_available(st.fifo, st.chunk);
      if (n == -2) {
        continue;
      }
      if (n <= 0) {
        return AppResult.Ok(REC_EOF);
      }
      for (var k: i64 = 0; k < n; k = k + 1) {
        st.pending.append_char((try st.chunk.get(k)));
      }
    }
    return AppResult.Ok(REC_TIMEOUT);
  }

  function input_waiting(st: ref Daemon) bool {
    if (st.pending.contains_char(CH_NL)) {
      return true;
    }
    return fifo_ready(st, 0) != 0;
  }

  // ------------------------------------------------------------------------
  // Serving one line
  // ------------------------------------------------------------------------

  // The paid call. Everything it needs beyond the line itself comes from the
  // shell's history snapshot and from the directory the line was typed in.
  function daemon_call(alloc: ref HeapAllocator, cfg: ref Config, st: ref Daemon, key: const ref String) AppResult<Vec<String>> {
    var out = Vec<String>(alloc, 4);
    if (cfg.api_key.length() == 0) {
      st.err = String(alloc, "ANTHROPIC_API_KEY is not set");
      return AppResult.Ok(out);
    }
    if (cfg.min_gap > 0 and rate_limit_ok(alloc, cfg, cfg.min_gap) == false) {
      return AppResult.Ok(out);
    }

    // `fc` is a shell builtin, so the shell is the only thing that can read
    // its own history; it drops a snapshot at every prompt for us to pick up.
    var history = Vec<String>(alloc, 8);
    if (cfg.history_lines > 0 and cfg.histfile.length() > 0) {
      match load_history(alloc, cfg, history) {
        AppResult.Ok => {},
        (e: const ref IError) => {
          history = Vec<String>(alloc, 8);
        }
      };
    }

    var listing = String(alloc, "");
    if (cfg.send_ls) {
      listing = (try list_dir(alloc, cfg.cwd, cfg.ls_limit));
    }

    var context = (try build_context(alloc, cfg, history, listing));

    var reply = Reply(alloc);

    match request_reply(alloc, cfg, context, reply) {
      AppResult.Ok => {},
      (e: const ref IError) => {
        st.err = String(alloc, "the request could not be sent");
        return AppResult.Ok(out);
      }
    };
    if (reply.failed) {
      st.err = reply.error.clone(alloc);
      if (st.err.length() == 0) {
        st.err = String(alloc, "the request failed");
      }
      return AppResult.Ok(out);
    }

    // The call worked. An answer with nothing usable in it is not a failure --
    // the model is allowed to have no suggestion -- so the row goes quiet
    // rather than showing an error.
    st.err = String(alloc, "");
    if (reply.suggestions.size() == 0) {
      return AppResult.Ok(out);
    }

    try cache_store(alloc, cfg, key, reply.suggestions);
    for (var i: i64 = 0; i < reply.suggestions.size(); i = i + 1) {
      out.push((try clone_item(alloc, reply.suggestions, i)));
    }
    return AppResult.Ok(out);
  }

  // network=false stays local (a cache read, ~2ms); network=true may pay for
  // an API call. Either way the answer lands in the table and the row is
  // repainted from it.
  function serve(alloc: ref HeapAllocator, cfg: ref Config, st: ref Daemon, rec: const ref String, network: bool) AppResult<void> {
    var line = rec_line(alloc, rec);
    if (line.length() < cfg.hint_min) {
      return AppResult.Ok;
    }
    if (network == false and (try table_find(st, line)) >= 0) {
      try render(alloc, cfg, st, line);
      return AppResult.Ok;
    }

    var cwd = rec_cwd(alloc, rec);
    cfg.set_target(alloc, line, cwd);

    var key = cache_key(alloc, cfg);
    var hit = (try cache_lookup(alloc, cfg, key));
    if (hit.size() == 0 and network) {
      hit = (try daemon_call(alloc, cfg, st, key));
    }

    if (hit.size() > 0) {
      var top = (try clone_item(alloc, hit, 0));
      if (top.equals(line) == false) {
        try table_put(alloc, st, line, top);
        st.last = top.clone(alloc);
      }
    }

    // Newer keystrokes are already queued: this answer is for a line the user
    // has moved past, and painting it would fight the round about to run.
    if (network and input_waiting(st)) {
      return AppResult.Ok;
    }
    try render(alloc, cfg, st, line);

    return AppResult.Ok;
  }

  // The shell could not find the command, and the shell has already printed its
  // own message and handed the prompt back -- the whole point of doing this
  // here is that nobody is waiting for it. Paid immediately rather than
  // debounced: the line is finished, there is no next keystroke to wait for.
  function serve_dym(alloc: ref HeapAllocator, cfg: ref Config, st: ref Daemon, rec: const ref String) AppResult<void> {
    // The record is a knock on the door; the line itself is in the file the
    // handler wrote, as "<word> TAB <fallback> TAB <what `history 1` printed>".
    // Reading it here rather than in the shell keeps the picking-apart -- the
    // history number, the first-word check -- in one place with a test.
    if (cfg.dymfile.length() == 0) {
      return AppResult.Ok;
    }
    var content = String(alloc, "");
    match read_to_string(alloc, cfg.dymfile) {
      SystemResult.Ok(value) => {
        content = value;
      },
      (e: const ref IError) => {
        return AppResult.Ok;
      }
    };
    remove_path(alloc, cfg.dymfile);

    var fields = content.split(alloc, CH_TAB);
    if (fields.size() < 3) {
      return AppResult.Ok;
    }
    var word = (try clone_item(alloc, fields, 0));
    var fallback = (try clone_item(alloc, fields, 1));
    var raw = String(alloc, "");
    for (var f: i64 = 2; f < fields.size(); f = f + 1) {
      if (f > 2) {
        raw.append_char(CH_TAB);
      }
      raw.append((try fields.get(f)));
    }
    word.trim();
    fallback.trim();

    var typed = (try history_line(alloc, raw, word, fallback));
    typed.trim();
    if (typed.length() == 0) {
      return AppResult.Ok;
    }

    var cwd = rec_cwd(alloc, rec);
    cfg.set_query_target(alloc, "dym", typed, cwd);

    // The gap between API calls exists to bound what a burst of typing can
    // spend. One correction per command the shell could not find is not a burst.
    var saved_gap: i64 = cfg.min_gap;
    cfg.min_gap = 0;

    var key = cache_key(alloc, cfg);
    var hit = (try cache_lookup(alloc, cfg, key));
    if (hit.size() == 0) {
      hit = (try daemon_call(alloc, cfg, st, key));
    }

    cfg.min_gap = saved_gap;
    cfg.clear_query_target(alloc);

    if (hit.size() == 0) {
      return AppResult.Ok;
    }
    // Two rules, both the same rule: this row belongs to the command that
    // failed, and to nothing else. Keystrokes queued while the answer was in
    // flight mean the user is already typing the next line, and a row that is
    // not empty means a hint for that line is up. Either way the answer is
    // stale before it is drawn -- it stays in the cache, where the same typo
    // will find it, and the row is left alone.
    if (input_waiting(st)) {
      return AppResult.Ok;
    }
    if (st.screen.length() > 0) {
      return AppResult.Ok;
    }

    var row = String(alloc, "");
    row.append(cfg.dym_prefix);
    row.append((try hit.get(0)));
    paint(alloc, st, row);

    return AppResult.Ok;
  }

  // Every wait below can be the one a correction or a key press lands in --
  // both are posted while the daemon is anywhere in its cycle -- and neither
  // is a line being typed. So they are served here, and the caller only ever
  // sees records that are.
  function next_line_record(alloc: ref HeapAllocator, cfg: ref Config, st: ref Daemon, timeout_ms: i32, out: ref String) AppResult<i32> {
    var r: i32 = (try next_record(alloc, st, timeout_ms, out));
    var more: bool = true;
    while (r == REC_OK and more) {
      if (rec_is_stop(alloc, out)) {
        return AppResult.Ok(REC_EOF);
      } else if (rec_is_dym(alloc, out)) {
        try serve_dym(alloc, cfg, st, out);
        r = (try next_record(alloc, st, timeout_ms, out));
      } else if (rec_is_sync(alloc, out)) {
        try serve_sync(alloc, cfg, st, out);
        r = (try next_record(alloc, st, timeout_ms, out));
      } else {
        more = false;
      }
    }
    return AppResult.Ok(r);
  }

  // The shell is inside `read -t`, so an answer always goes back -- even an
  // empty one. A request that got no reply at all would leave it there until
  // the timeout, for nothing.
  function reply_send(alloc: ref HeapAllocator, cfg: ref Config, st: ref Daemon, id: const ref String, items: const ref Vec<String>, error: const ref String) AppResult<void> {
    if (cfg.reply.length() == 0) {
      return AppResult.Ok;
    }
    if (st.reply_open == false) {
      // A timed-out shell may no longer drain replies. Never let that stall
      // the daemon and fill the request pipe behind it.
      var fd: i32 = platform_fifo_open(cfg.reply);
      if (fd < 0) {
        return AppResult.Ok;
      }
      st.reply.adopt(fd);
      st.reply_open = true;
    }

    var msg = String(alloc, "");
    msg.append(id);
    msg.append_char(CH_TAB);
    if (error.length() > 0) {
      msg.append("E");
      msg.append_char(CH_TAB);
      for (var e: i64 = 0; e < error.length() and e < ERR_MAX; e = e + 1) {
        var c = string_byte(error, e);
        if (c < 32 or c == 127) {
          msg.append_char(CH_SP);
        } else {
          msg.append_char(c);
        }
      }
      msg.append_char(CH_NL);
      var error_written: i64 = st.reply.write(msg);
      return AppResult.Ok;
    }
    msg.append(items.size());
    msg.append_char(CH_NL);

    // <id> TAB <flag> TAB <command> TAB <description>. Ask mode answers
    // "COMMAND TAB DESCRIPTION" and completion answers a bare command; both
    // are split here, so the shell has a field to read rather than a string
    // to parse. The flag is "!" for a command worth stopping on before it
    // goes anywhere near a prompt -- that judgement is ours too.
    for (var i: i64 = 0; i < items.size(); i = i + 1) {
      var parts = (try items.get(i)).split(alloc, CH_TAB);
      var cmd = String(alloc, "");
      var desc = String(alloc, "");
      if (parts.size() > 0) {
        cmd = (try clone_item(alloc, parts, 0));
      }
      if (parts.size() > 1) {
        desc = (try clone_item(alloc, parts, 1));
      }
      cmd.trim();
      desc.trim();

      msg.append(id);
      msg.append_char(CH_TAB);
      if (looks_destructive(alloc, cmd)) {
        msg.append("!");
      } else {
        msg.append("-");
      }
      msg.append_char(CH_TAB);
      msg.append(cmd);
      msg.append_char(CH_TAB);
      msg.append(desc);
      msg.append_char(CH_NL);
    }
    var written: i64 = st.reply.write(msg);

    return AppResult.Ok;
  }

  // A request the shell is blocked on: Alt-O, Alt-A or Alt-G. The shell has
  // nothing to do but wait, so this is paid immediately and never debounced,
  // and the answer goes straight back down the reply FIFO. The hint row is
  // not touched: the shell owns what happens to the line it asked about.
  function serve_sync(alloc: ref HeapAllocator, cfg: ref Config, st: ref Daemon, rec: const ref String) AppResult<void> {
    var marked = rec_line(alloc, rec);
    var body = String(alloc, "");
    for (var i: i64 = 1; i < marked.length(); i = i + 1) {
      body.append_char(string_byte(marked, i));
    }

    // <id> TAB <mode> TAB <line>. The line is whatever is left, tabs and all.
    var fields = body.split(alloc, CH_TAB);
    if (fields.size() < 3) {
      return AppResult.Ok;
    }
    var id = (try clone_item(alloc, fields, 0));
    var mode = (try clone_item(alloc, fields, 1));
    var subject = String(alloc, "");
    for (var f: i64 = 2; f < fields.size(); f = f + 1) {
      if (f > 2) {
        subject.append_char(CH_TAB);
      }
      subject.append((try fields.get(f)));
    }

    var out = Vec<String>(alloc, 4);
    var error = String(alloc, "");
    var trimmed = subject.clone(alloc);
    trimmed.trim();
    // The same floor the one-shot run applies: two characters is not enough
    // to be worth a round trip.
    if (trimmed.length() >= 3) {
      var cwd = rec_cwd(alloc, rec);
      if (mode.equals_literal("a")) {
        cfg.set_query_target(alloc, "ask", subject, cwd);
      } else {
        cfg.set_query_target(alloc, "complete", subject, cwd);
        cfg.line = subject.clone(alloc);
      }

      // A key press is one request, not a burst; the gap that bounds what
      // typing can spend does not apply to it.
      var saved_gap: i64 = cfg.min_gap;
      cfg.min_gap = 0;

      var key = cache_key(alloc, cfg);
      out = (try cache_lookup(alloc, cfg, key));
      if (out.size() == 0) {
        out = (try daemon_call(alloc, cfg, st, key));
        if (out.size() == 0 and st.err.length() > 0) {
          error = st.err.clone(alloc);
        }
      }

      cfg.min_gap = saved_gap;
      cfg.clear_query_target(alloc);
      cfg.line = String(alloc, "");
    }

    try reply_send(alloc, cfg, st, id, out, error);

    return AppResult.Ok;
  }

  // ------------------------------------------------------------------------
  // The loop
  // ------------------------------------------------------------------------

  // Blocks on the FIFO, so an idle shell costs nothing at all. A record means
  // a keystroke; a short gap means a look at the cache; a debounce interval of
  // silence means the user has stopped and the request is worth paying for.
  function daemon_loop(alloc: ref HeapAllocator, cfg: ref Config, st: ref Daemon) i32 {
    var cur = String(alloc, "");
    var msg = String(alloc, "");
    var quiet_ms: i32 = _convert<i32>(cfg.quiet_ms);
    var debounce_ms: i32 = _convert<i32>(cfg.debounce_ms);

    var running: bool = true;
    while (running) {
      match daemon_step(alloc, cfg, cur, msg, st, running, quiet_ms, debounce_ms) {
        AppResult.Ok => {},
        (e: const ref IError) => {
          // Discard a failed request and leave the input loop available.
          clear_row(alloc, st);
          st.keys.clear();
          st.vals.clear();
        }
      };
    }
    return 0;
  }

  // ------------------------------------------------------------------------
  // Startup
  // ------------------------------------------------------------------------

  // So the shell can tell at the next prompt whether we are still here,
  // without a fork: `read -r pid < file` and `kill -0` are both builtins.
  function write_pid(alloc: ref HeapAllocator, cfg: ref Config, child: i32) void {
    if (cfg.pidfile.length() == 0) {
      return;
    }
    var s = String(alloc, "");
    s.append(child);
    s.append("\n");
    match write_string(cfg.pidfile, s) {
      (e: const ref IError) => {
        // Without the pid file the shell simply never respawns us.
      },
      _ => {}
    };
  }

  // Point our own stdin, stdout and stderr at /dev/null. The inherited ones
  // are the user's terminal, where a stray byte would land in the middle of
  // the line being typed.
  function silence_std_streams() void {
    var sink = File();

    match redirect_std_streams(sink) {
      AppResult.Ok => {},
      (e: const ref IError) => {
        // Nothing useful to say, and nowhere left to say it.
      }
    };
  }

  /** Start the detached process that serves interactive hint requests. */
  public function daemon_run(alloc: ref HeapAllocator, cfg: ref Config) i32 {
    if (cfg.fifo.length() == 0) {
      return 0;
    }

    var child: i32 = 0;
    match fork() {
      SystemResult.Ok(value) => {
        child = value;
      },
      (e: const ref IError) => {
        return 1;
      }
    };
    if (child > 0) {
      // The shell called us synchronously; hand it back its prompt at once.
      // The pid goes down here rather than in the child, so that it is already
      // on disk when this returns: the shell checks it at the next prompt, and
      // a check that lost the race would spawn a second daemon onto the same
      // FIFO and the two would split the records between them.
      write_pid(alloc, cfg, child);
      return 0;
    }

    // Our own process group. Terminal-generated signals go to the foreground
    // group, and Ctrl-C must not take the hint row with it. new_session() would
    // do that too, but it also drops the controlling terminal -- and /dev/tty
    // is the one thing we cannot do without.
    match set_pgid(0, 0) {
      (e: const ref IError) => {
        // Already a group leader, or the shell moved us; neither is fatal.
      },
      _ => {}
    };

    // Everything the shell had open came with us through fork+exec, and one of
    // those descriptors is the *write* end of our own FIFO: the shell opens it
    // read-write so that it never blocks on its own helper. Holding a copy of
    // it would mean the FIFO always has a writer, so the read below would never
    // reach end-of-file and this process would outlive the shell it draws for.
    // Nothing inherited is of any use to us, so drop all of it.
    for (var fd: i32 = 3; fd < MAX_INHERITED_FD; fd = fd + 1) {
      close_fd(fd);
    }
    silence_std_streams();

    var st = Daemon(alloc);
    match st.tty.open(cfg.tty_path, FileMode.Write) {
      (e: const ref IError) => {
        return 0;
      },
      _ => {}
    };
    // Read-only, so that when the shell closes its end we see end-of-file and
    // stop rather than outliving the shell we were drawing for.
    match st.fifo.open(cfg.fifo, FileMode.Read) {
      (e: const ref IError) => {
        st.tty.close();
        return 0;
      },
      _ => {}
    };

    var rc = daemon_loop(alloc, cfg, st);
    clear_row(alloc, st);
    st.fifo.close();
    st.tty.close();
    if (cfg.pidfile.length() > 0) {
      remove_path(alloc, cfg.pidfile);
    }
    return rc;
  }

  /** Load and parse the shell history snapshot. */
  function load_history(alloc: ref HeapAllocator, cfg: ref Config, history: ref Vec<String>) AppResult<void> {
    var raw = (try read_to_string(alloc, cfg.histfile));
    history = (try parse_history(alloc, raw, cfg.history_lines));

    return AppResult.Ok;
  }

  /** Coalesce input and serve one settled request. */
  function daemon_step(alloc: ref HeapAllocator, cfg: ref Config, cur: ref String, msg: ref String, st: ref Daemon, running: ref bool, quiet_ms: i32, debounce_ms: i32) AppResult<void> {
    if ((try next_line_record(alloc, cfg, st, -1, cur)) != REC_OK) {
      running = false;
    } else {
      try render(alloc, cfg, st, rec_line(alloc, cur));

      // Coalesce the burst: mid-word keystrokes are not worth a lookup each.
      var settled: bool = false;
      while (settled == false) {
        var q: i32 = (try next_line_record(alloc, cfg, st, quiet_ms, msg));
        if (q == REC_OK) {
          cur.clear();
          cur.append(msg);
          try render(alloc, cfg, st, rec_line(alloc, cur));
        } else {
          settled = true;
          if (q == REC_EOF) {
            running = false;
          }
        }
      }

      if (running) {
        try serve(alloc, cfg, st, cur, false);

        var idle: bool = false;
        while (idle == false and running) {
          var d: i32 = (try next_line_record(alloc, cfg, st, debounce_ms, msg));
          if (d == REC_TIMEOUT) {
            idle = true;
          } else {
            if (d == REC_EOF) {
              running = false;
            } else {
              cur.clear();
              cur.append(msg);
              try render(alloc, cfg, st, rec_line(alloc, cur));

              var quiet2: bool = false;
              while (quiet2 == false) {
                var r: i32 = (try next_line_record(alloc, cfg, st, quiet_ms, msg));
                if (r == REC_OK) {
                  cur.clear();
                  cur.append(msg);
                  try render(alloc, cfg, st, rec_line(alloc, cur));
                } else {
                  quiet2 = true;
                  if (r == REC_EOF) {
                    running = false;
                  }
                }
              }
              if (running) {
                try serve(alloc, cfg, st, cur, false);
              }
            }
          }
        }

        if (running and idle) {
          try serve(alloc, cfg, st, cur, true);
        }
      }
    }

    return AppResult.Ok;
  }

  /** Redirect inherited standard descriptors to the null device. */
  function redirect_std_streams(sink: ref File) AppResult<void> {
    try sink.open("/dev/null", FileMode.Read);
    try dup_fd(sink.get_fd(), 0);
    sink.close();
    try sink.open("/dev/null", FileMode.Write);
    try dup_fd(sink.get_fd(), 1);
    try dup_fd(sink.get_fd(), 2);
    sink.close();

    return AppResult.Ok;
  }

  /** Copy an entry name before comparing it with another borrowed entry. */
  function clone_entry_name(alloc: const ref HeapAllocator, entries: ref Vec<DirEntry>, index: i64) AppResult<String> {
    var entry = try entries.get(index);
    return AppResult.Ok(entry.name().clone(alloc));
  }
}
