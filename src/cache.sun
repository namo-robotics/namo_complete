// cache.sun - local suggestion cache and rate limiting.
//
// Terminal autocomplete gets re-triggered on near-identical input constantly,
// and every miss is a paid round trip. The cache is keyed on the normalized
// prefix plus cwd plus shell plus model, so a different directory gets different answers.

/** Cache suggestions and limit request frequency. */
public module namo {
  using std;
  using std.io;
  using std.time;

  /** Two independent rolling hashes, concatenated -- ~60 bits of key. This is
   * a cache key, not a security primitive. */
  public function cache_key(alloc: ref HeapAllocator, cfg: const ref Config) String {
    var subject = String(alloc, "");
    if (cfg.is_dym()) {
      subject.append("dym:");
      subject.append(cfg.query);
    } else if (cfg.is_ask()) {
      subject.append("ask:");
      subject.append(cfg.query);
    } else {
      subject.append(cfg.line);
    }
    var material = normalize_ws(alloc, subject);
    material.append(" ");
    material.append(cfg.cwd);
    material.append(" ");
    material.append(cfg.shell_name);
    material.append(" ");
    material.append(cfg.model);

    var key = String(alloc, "");
    key.append_hex(hash_str(material, 2166136261));
    key.append("-");
    key.append_hex(hash_str(material, 972663749));
    return key;
  }

  function cache_file(alloc: ref HeapAllocator, cfg: const ref Config, key: const ref String) String {
    var p = String(alloc, "");
    p.append(cfg.cache_dir);
    p.append("/");
    p.append(key);
    p.append(".txt");
    return p;
  }

  /** Cache format: first line is the unix timestamp, remaining lines are the
   * suggestions. Returns an empty Vec on miss or expiry. */
  public function cache_lookup(alloc: ref HeapAllocator, cfg: const ref Config, key: const ref String) AppResult<Vec<String>> {
    var out = Vec<String>(alloc, 4);
    // NAMO_CACHE=0 means neither read nor written -- checked here rather than
    // at every call site, because the daemon's sites forgot to.
    if (cfg.use_cache == false) {
      return AppResult.Ok(out);
    }
    var path = cache_file(alloc, cfg, key);

    var raw = String(alloc, "");
    match read_to_string(alloc, path) {
      SystemResult.Ok(value) => {
        raw = value;
      },
      (e: const ref IError) => {
        return AppResult.Ok(out);
      }
    };

    var lines = (try split_lines(alloc, raw));
    if (lines.size() < 2) {
      return AppResult.Ok(out);
    }

    var stamped = (try clone_item(alloc, lines, 0)).parse_i64();
    var ts: i64 = match stamped {
      Option.Some(v) => v,
      Option.None => 0
    };
    if (ts <= 0 or read_unix_time() - ts > cfg.cache_ttl) {
      return AppResult.Ok(out);
    }

    for (var i: i64 = 1; i < lines.size(); i = i + 1) {
      out.push((try clone_item(alloc, lines, i)));
    }
    return AppResult.Ok(out);
  }

  /** Store non-empty suggestions under a cache key. */
  public function cache_store(alloc: ref HeapAllocator, cfg: const ref Config, key: const ref String, items: const ref Vec<String>) AppResult<void> {
    if (cfg.use_cache == false) {
      return AppResult.Ok;
    }
    if (items.size() == 0) {
      return AppResult.Ok;
    }
    ensure_dir_p(alloc, cfg.cache_dir);

    var body = String(alloc, "");
    body.append(read_unix_time());
    body.append("\n");
    for (var i: i64 = 0; i < items.size(); i = i + 1) {
      body.append((try items.get(i)));
      body.append("\n");
    }

    var path = cache_file(alloc, cfg, key);
    match write_string(path, body) {
      (e: const ref IError) => {
        // A cache write failure is never fatal.
      },
      _ => {}
    };

    return AppResult.Ok;
  }

  /** Minimum interval between API calls, enforced with a stamp file.
   * Returns false when the caller should back off. */
  public function rate_limit_ok(alloc: ref HeapAllocator, cfg: const ref Config, min_gap: i64) bool {
    ensure_dir_p(alloc, cfg.cache_dir);
    var path = String(alloc, "");
    path.append(cfg.cache_dir);
    path.append("/.last_call");

    var current: i64 = read_unix_time();
    var last: i64 = 0;

    match read_rate_stamp(alloc, path, last) {
      AppResult.Ok => {},
      (e: const ref IError) => {
        last = 0;
      }
    };

    if (last > 0 and current - last < min_gap) {
      return false;
    }

    var stamp = String(alloc, "");
    stamp.append(current);
    match write_string(path, stamp) {
      (e: const ref IError) => {
        // Non-fatal.
      },
      _ => {}
    };
    return true;
  }

  /** Read the last request timestamp when its stamp file is available. */
  function read_rate_stamp(alloc: ref HeapAllocator, path: ref String, last: ref i64) AppResult<void> {
    var raw = (try read_to_string(alloc, path));
    raw.trim();
    var parsed = raw.parse_i64();
    last = match parsed {
      Option.Some(v) => v,
      Option.None => 0
    };

    return AppResult.Ok;
  }
}
