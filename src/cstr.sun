// cstr.sun - String <-> C string bridge.
//
// Sun's String keeps its byte storage in a private `data` field, and
// ContiguousBuffer.rawData() makes no NUL-termination promise, so every call
// into C needs an explicit NUL-terminated copy built from the public API
// (length() + at()).  Callers must keep the returned buffer alive for as long
// as the raw pointer is in use.

public module namo {
  using sun;

  extern "C" function strlen(s: raw_ptr<u8>) i64;

  // NUL-terminated copy of `s`, suitable for passing to C as raw_ptr<u8>.
  public function to_cstr(alloc: ref HeapAllocator, s: ref String) ContiguousBuffer<u8> {
    var n: i64 = s.length();
    var buf = ContiguousBuffer<u8>(alloc, n + 1);
    for (var i: i64 = 0; i < n; i = i + 1) {
      buf.set_unchecked(i, s.at(i));
    }
    buf.set_unchecked(n, 0);
    return buf;
  }

  // Copy a NUL-terminated C string into an owned String. Null pointer -> "".
  public function from_cstr(alloc: ref HeapAllocator, p: raw_ptr<u8>) String {
    var out = String(alloc, "");
    if (p == null) {
      return out;
    }
    var n: i64 = unsafe { strlen(p); };
    for (var i: i64 = 0; i < n; i = i + 1) {
      out.append_char(unsafe { _load<u8>(p, i); });
    }
    return out;
  }
}
