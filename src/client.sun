// client.sun - HTTPS via the curl binary.
//
// Sun's stdlib has TCP but no TLS, so the request goes out through curl. It is
// run with sun.process.Command, which execs curl directly: there is no shell,
// so no command string to quote and nothing user-controlled to escape.
//
// The API key is the one argument that must not be visible: argv shows up in
// `ps`, so the key goes down curl's stdin as a one-line config file (`-K -`)
// and never touches the disk or the process table. Everything else -- the URL,
// the fixed headers, the path of the request body -- rides in argv, where the
// kernel keeps the arguments apart and no quoting rules apply.

public module namo {
  using sun;
  using sun.io;
  using sun.process;

  public class Reply {
    public var suggestions: Vec<String>;
    public var failed: bool;

    public function init(alloc: ref HeapAllocator) {
      this.suggestions = Vec<String>(alloc, 4);
      this.failed = false;
    }
  }

  // curl's config format is line-based and understands backslash escapes
  // inside a quoted value, so a key carrying a newline or a quote could add
  // directives of its own. Keys never contain either; one that does is
  // rejected rather than escaped.
  function usable_key(key: const ref String) bool {
    if (key.length() == 0) {
      return false;
    }
    for (var i: i64 = 0; i < key.length(); i = i + 1) {
      var c: u8 = key.at(i);
      if (c < 32 or c == 34 or c == 92 or c == 127) {
        return false;
      }
    }
    return true;
  }

  // The whole of curl's stdin: the header that must stay out of `ps`.
  function build_conf(alloc: ref HeapAllocator, cfg: const ref Config) String {
    var conf = String(alloc, "header = \"x-api-key: ");
    conf.append(cfg.api_key);
    conf.append("\"\n");
    return conf;
  }

  public function call_api(alloc: ref HeapAllocator, cfg: const ref Config, body: ref String) Reply, IError {
    var reply = Reply(alloc);

    if (usable_key(cfg.api_key) == false) {
      eprint("[namo] ANTHROPIC_API_KEY is not a usable header value\n");
      reply.failed = true;
      return reply;
    }

    // One request body per process, so a daemon and an Alt-O run in the
    // same shell cannot overwrite each other's file.
    ensure_dir_p(alloc, cfg.runtime_dir);
    var p_body = cfg.rt_path(alloc, "body.");
    p_body.append(pid());
    p_body.append(".json");
    write_string(p_body, body);

    var data_arg = String(alloc, "@");
    data_arg.append(p_body);

    var cmd = Command(alloc, "curl");
    cmd.arg("-sS");
    cmd.arg("--max-time");
    cmd.arg("8");
    cmd.arg("-K");
    cmd.arg("-");
    cmd.arg("-H");
    cmd.arg("anthropic-version: 2023-06-01");
    cmd.arg("-H");
    cmd.arg("content-type: application/json");
    cmd.arg("--data-binary");
    cmd.arg(data_arg);
    cmd.arg(cfg.endpoint);
    cmd.stdin(Stdio.Piped);
    cmd.stdout(Stdio.Piped);
    cmd.stderr(Stdio.Piped);

    var child = cmd.start();
    var conf = build_conf(alloc, cfg);
    child.write_stdin(conf);
    child.close_stdin();
    // Drains both pipes while curl runs, so a large response cannot wedge it.
    var result = child.collect(alloc);

    remove_path(alloc, p_body);

    if (result.status() != 0) {
      var m = String(alloc, "[namo] curl exit ");
      m.append(result.status());
      m.append(": ");
      m.append(result.stderr());
      m.append("\n");
      eprint(m);
      reply.failed = true;
      return reply;
    }

    parse_reply(alloc, cfg, result.stdout(), reply);
    return reply;
  }

  // Pull the completion lines out of a Messages API response.
  public function parse_reply(alloc: ref HeapAllocator, cfg: const ref Config, raw: const ref String, reply: ref Reply) void {
    try {
      var doc = json_parse(alloc, raw);

      if (doc.has("error")) {
        var msg = doc.get("error").get("message").as_string();
        var m = String(alloc, "[namo] api error: ");
        m.append(msg);
        m.append("\n");
        eprint(m);
        reply.failed = true;
        return;
      }

      var text = doc.get("content").at(0).get("text").as_string();
      var lines = split_lines(alloc, text);

      // A truncated response leaves a partial final line; drop it.
      var usable: i64 = lines.size();
      if (doc.has("stop_reason")) {
        if (doc.get("stop_reason").as_string().equals_literal("max_tokens")) {
          if (usable > 1) {
            usable = usable - 1;
          }
        }
      }

      for (var i: i64 = 0; i < usable; i = i + 1) {
        if (reply.suggestions.size() >= cfg.max_suggestions) {
          return;
        }
        var cand = lines.get_unchecked(i).clone(alloc);
        if (cand.length() > 0) {
          // Ask mode answers "COMMAND<TAB>DESCRIPTION", so only the command
          // half is judged. A line that does not read like a command is
          // dropped rather than shown; see looks_like_command.
          var parts = cand.split(alloc, CH_TAB);
          var head = parts.get_unchecked(0).clone(alloc);
          head.trim();
          if (looks_like_command(alloc, head)) {
            reply.suggestions.push(cand);
          }
        }
      }
    } catch (e: IError) {
      eprint("[namo] could not parse api response\n");
      reply.failed = true;
    }
  }
}
