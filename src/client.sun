// client.sun - HTTP and verified HTTPS without a subprocess.
//
// Production requests use Sun's TLS bundle. Plain HTTP remains supported for
// NAMO_ENDPOINT so the test suite can run against a loopback mock server.

/** Build HTTP requests and parse completion responses. */
public module namo {
  using std;
  using tls;

  /** Holds parsed suggestions or a user-facing request failure. */
  public class Reply {
    public var suggestions: Vec<String>;
    public var failed: bool;
    // Why it failed, short enough for the hint row. The daemon's stderr goes
    // to /dev/null -- the shell integration starts it that way -- so this
    // string is the only way a failure can reach the user; see daemon.sun.
    public var error: String;

    init(alloc: ref HeapAllocator) {
      this.suggestions = Vec<String>(alloc, 4);
      this.failed = false;
      this.error = String(alloc, "");
    }
  }

  class Endpoint {
    var secure: bool;
    var host: String;
    var port: i32;
    var path: String;

    init(alloc: ref HeapAllocator) {
      this.secure = true;
      this.host = String(alloc, "");
      this.port = 443;
      this.path = String(alloc, "/");
    }
  }

  // Reject bytes that cannot safely appear inside an HTTP header value.
  function usable_key(key: const ref String) bool {
    if (key.length() == 0) {
      return false;
    }
    for (var i: i64 = 0; i < key.length(); i = i + 1) {
      var c: u8 = string_byte(key, i);
      if (c < 32 or c == 34 or c == 92 or c == 127) {
        return false;
      }
    }
    return true;
  }

  // Accept DNS names and IPv4 literals without header delimiters.
  function usable_host_char(c: u8) bool {
    return (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z') or (c >= b'0' and c <= b'9') or c == b'.' or c == b'-';
  }

  function parse_endpoint(alloc: ref HeapAllocator, raw: const ref String) AppResult<Endpoint> {
    var out = Endpoint(alloc);
    var start: i64 = 0;
    if (raw.starts_with("https://")) {
      start = 8;
    } else {
      if (raw.starts_with("http://")) {
        out.secure = false;
        out.port = 80;
        start = 7;
      } else {
        return AppResult.Error(Error(-1, "NAMO_ENDPOINT must start with http:// or https://"));
      }
    }

    var slash: i64 = raw.length();
    for (var i: i64 = start; i < raw.length(); i = i + 1) {
      if (string_byte(raw, i) == b'/') {
        slash = i;
        break;
      }
    }
    var colon: i64 = -1;
    for (var i: i64 = start; i < slash; i = i + 1) {
      if (string_byte(raw, i) == b':') {
        colon = i;
      }
    }
    var host_end: i64 = slash;
    if (colon >= 0) {
      host_end = colon;
      var port_text = string_slice(alloc, raw, colon + 1, slash - colon - 1);
      var parsed_port: i64 = match port_text.parse_i64() {
        Option.Some(value) => value,
        Option.None => {
          return AppResult.Error(Error(-1, "NAMO_ENDPOINT has an invalid port"));
        }
      };
      if (parsed_port <= 0 or parsed_port > 65535) {
        return AppResult.Error(Error(-1, "NAMO_ENDPOINT has an invalid port"));
      }
      out.port = _convert<i32>(parsed_port);
    }
    if (host_end <= start) {
      return AppResult.Error(Error(-1, "NAMO_ENDPOINT has an invalid host"));
    }
    out.host = string_slice(alloc, raw, start, host_end - start);
    for (var i: i64 = 0; i < out.host.length(); i = i + 1) {
      var c: u8 = string_byte(out.host, i);
      if (usable_host_char(c) == false) {
        return AppResult.Error(Error(-1, "NAMO_ENDPOINT has an invalid host"));
      }
    }
    if (out.secure == false and out.host.equals_literal("127.0.0.1") == false and out.host.equals_literal("localhost") == false) {
      return AppResult.Error(Error(-1, "plaintext NAMO_ENDPOINT must use loopback"));
    }
    if (slash < raw.length()) {
      out.path = string_slice(alloc, raw, slash, raw.length() - slash);
    }
    if (out.path.contains("#")) {
      return AppResult.Error(Error(-1, "NAMO_ENDPOINT must not contain a fragment"));
    }
    for (var i: i64 = 0; i < out.path.length(); i = i + 1) {
      var c: u8 = string_byte(out.path, i);
      if (c <= 32 or c == 127) {
        return AppResult.Error(Error(-1, "NAMO_ENDPOINT has an invalid path"));
      }
    }
    return AppResult.Ok(out);
  }

  function build_request(alloc: ref HeapAllocator, cfg: const ref Config, endpoint: const ref Endpoint, body: const ref String) String {
    var req = String(alloc, "POST ");
    req.append(endpoint.path);
    req.append(" HTTP/1.1");
    append_crlf(req);
    req.append("Host: ");
    req.append(endpoint.host);
    if ((endpoint.secure and endpoint.port != 443) or (endpoint.secure == false and endpoint.port != 80)) {
      req.append(":");
      req.append(endpoint.port);
    }
    append_crlf(req);
    req.append("anthropic-version: 2023-06-01");
    append_crlf(req);
    req.append("x-api-key: ");
    req.append(cfg.api_key);
    append_crlf(req);
    req.append("content-type: application/json");
    append_crlf(req);
    req.append("content-length: ");
    req.append(body.length());
    append_crlf(req);
    req.append("connection: close");
    append_crlf(req);
    append_crlf(req);
    req.append(body);
    return req;
  }

  function read_tls(alloc: ref HeapAllocator, endpoint: ref Endpoint, request: ref String) AppResult<String> {
    var stream = TlsStream();
    try stream.connect(endpoint.host, endpoint.port);
    try stream.send_string(request);
    var raw = String(alloc, "");
    var chunk = ContiguousBuffer<u8>(alloc, 8192);
    var n: i64 = (try stream.recv(chunk));
    while (n > 0) {
      for (var i: i64 = 0; i < n; i = i + 1) {
        raw.append_char((try chunk.get(i)));
      }
      n = (try stream.recv(chunk));
    }
    stream.close();
    return AppResult.Ok(raw);
  }

  function read_tcp(alloc: ref HeapAllocator, endpoint: ref Endpoint, request: const ref String) AppResult<String> {
    var stream = TcpStream();
    if (endpoint.host.equals_literal("127.0.0.1")) {
      try stream.connect_local(endpoint.port);
    } else {
      try stream.connect_host(endpoint.host, endpoint.port);
    }
    try stream.send_string(request);
    var raw = String(alloc, "");
    var chunk = ContiguousBuffer<u8>(alloc, 8192);
    var n: i64 = (try stream.recv(chunk));
    while (n > 0) {
      for (var i: i64 = 0; i < n; i = i + 1) {
        raw.append_char((try chunk.get(i)));
      }
      n = (try stream.recv(chunk));
    }
    stream.close();
    return AppResult.Ok(raw);
  }

  /** Send one request to the configured HTTP or HTTPS endpoint. */
  public function call_api(alloc: ref HeapAllocator, cfg: const ref Config, body: ref String) AppResult<Reply> {
    var reply = Reply(alloc);

    if (usable_key(cfg.api_key) == false) {
      eprint("[namo] ANTHROPIC_API_KEY is not a usable header value\n");
      reply.failed = true;
      return AppResult.Ok(reply);
    }

    var endpoint = (try parse_endpoint(alloc, cfg.endpoint));
    var request = build_request(alloc, cfg, endpoint, body);
    var raw = String(alloc, "");
    if (endpoint.secure) {
      raw = (try read_tls(alloc, endpoint, request));
    } else {
      raw = (try read_tcp(alloc, endpoint, request));
    }
    var response = HttpClientResponse(alloc);
    try parse_response(alloc, raw, response);
    parse_reply(alloc, cfg, response.body, reply);
    if ((response.status < 200 or response.status >= 300) and (reply.failed == false or reply.error.equals_literal("could not parse api response"))) {
      var message = String(alloc, "HTTP status ");
      message.append(response.status);
      eprint("[namo] request failed with ");
      eprint(message);
      eprint("\n");
      reply.failed = true;
      reply.error = message;
    }
    return AppResult.Ok(reply);
  }

  /** Pull the completion lines out of a Messages API response. */
  public function parse_reply(alloc: ref HeapAllocator, cfg: const ref Config, raw: const ref String, reply: ref Reply) void {
    match parse_reply_checked(alloc, cfg, raw, reply) {
      AppResult.Ok => {},
      (e: const ref IError) => {
        eprint("[namo] could not parse api response\n");
        reply.failed = true;
        reply.error = String(alloc, "could not parse api response");
      }
    };
  }

  /** Parse a response and propagate malformed JSON or checked-access failures. */
  function parse_reply_checked(alloc: ref HeapAllocator, cfg: const ref Config, raw: const ref String, reply: ref Reply) AppResult<void> {
    var doc = (try parse_json(alloc, raw));

    if (doc.has("error")) {
      var msg = (try (try (try doc.get("error")).get("message")).as_string());
      var m = String(alloc, "[namo] api error: ");
      m.append(msg);
      m.append("\n");
      eprint(m);
      reply.failed = true;
      reply.error = msg.clone(alloc);
      return AppResult.Ok;
    }

    // Not content[0]: a model with thinking on -- which is the default from
    // Claude Opus 5 on -- puts a `thinking` block first, and the block the
    // completions are in is somewhere after it. Blocks with no "text"
    // member are skipped rather than assumed away.
    var truncated: bool = false;
    if (doc.has("stop_reason")) {
      truncated = (try (try doc.get("stop_reason")).as_string()).equals_literal("max_tokens");
    }
    var ti: i64 = -1;
    var content = try doc.get("content");
    for (var i: i64 = 0; i < content.len(); i = i + 1) {
      if ((try content.at(i)).has("text")) {
        ti = i;
        break;
      }
    }
    if (ti < 0) {
      eprint("[namo] api response carried no text block\n");
      reply.failed = true;
      reply.error = String(alloc, "response had no text block");
      return AppResult.Ok;
    }

    var text = (try (try (try content.at(ti)).get("text")).as_string());
    var lines = (try split_lines(alloc, text));

    // A truncated response leaves a partial final line; drop it.
    var usable: i64 = lines.size();
    if (truncated and usable > 1) {
      usable = usable - 1;
    }

    for (var i: i64 = 0; i < usable; i = i + 1) {
      if (reply.suggestions.size() >= cfg.max_suggestions) {
        return AppResult.Ok;
      }
      var cand = (try clone_item(alloc, lines, i));
      if (cand.length() > 0) {
        // Ask mode answers "COMMAND<TAB>DESCRIPTION", so only the command
        // half is judged. A line that does not read like a command is
        // dropped rather than shown; see looks_like_command.
        var parts = cand.split(alloc, CH_TAB);
        var head = (try clone_item(alloc, parts, 0));
        head.trim();
        if ((try looks_like_command(alloc, head))) {
          reply.suggestions.push(cand);
        }
      }
    }

    return AppResult.Ok;
  }

  /** Build and send a completion request. */
  public function request_reply(alloc: ref HeapAllocator, cfg: const ref Config, context: const ref String, reply: ref Reply) AppResult<void> {
    var body = (try build_body(alloc, cfg, context));
    reply = (try call_api(alloc, cfg, body));

    return AppResult.Ok;
  }
}
