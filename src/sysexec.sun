// sysexec.sun - environment access and subprocess execution.
//
// run_curl() deliberately takes no arguments: the caller chdir()s into the
// runtime directory first, so the command string is a compile-time constant
// referring only to relative literal paths. No user-controlled byte ever
// reaches /bin/sh.

public module namo {
  using sun;

  extern "C" function getenv(name: raw_ptr<u8>) raw_ptr<u8>;
  extern "C" function system(cmd: raw_ptr<u8>) i32;
  extern "C" function chdir(path: raw_ptr<u8>) i32;
  extern "C" function time(t: raw_ptr<i64>) i64;
  extern "C" function getuid() i32;

  // getenv for a literal name. Empty string when unset.
  public function env(alloc: ref HeapAllocator, name: static_ptr<u8>) String {
    var raw: raw_ptr<u8> = _static_ptr_data<u8>(name);
    return from_cstr(alloc, unsafe { getenv(raw); });
  }

  public function env_or(alloc: ref HeapAllocator, name: static_ptr<u8>,
                         fallback: static_ptr<u8>) String {
    var v = env(alloc, name);
    if (v.length() == 0) {
      return String(alloc, fallback);
    }
    return v;
  }

  public function change_dir(alloc: ref HeapAllocator, path: ref String) i32 {
    var c = to_cstr(alloc, path);
    return unsafe { chdir(c.rawData()); };
  }

  public function now_seconds() i64 {
    return unsafe { time(null); };
  }

  public function uid() i32 {
    return unsafe { getuid(); };
  }

  // Decode a wait(2) status into the child's exit code.
  function exit_code_of(status: i32) i32 {
    return (status >> 8) & 255;
  }

  // Run curl against ./req.conf in the current directory. Constant command.
  public function run_curl() i32 {
    var status: i32 = unsafe {
      system("curl -sS -K ./req.conf > ./http_code.txt 2> ./curl.err");
    };
    if (status < 0) {
      return 127;
    }
    return exit_code_of(status);
  }
}
