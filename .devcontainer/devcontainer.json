{
	"name": "namo_complete (Ubuntu 26.04)",
	"build": {
		"context": "..",
		"dockerfile": "../Dockerfile"
	},
	// Bind mounts fail if the host source path is missing, so create the
	// optional ones on the host before the container starts.
	"initializeCommand": "mkdir -p \"${localEnv:HOME}${localEnv:USERPROFILE}/.codex\"",
	"remoteUser": "ubuntu",
	"updateRemoteUserUID": true,
	"workspaceFolder": "/workspace",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/ubuntu/.ssh,type=bind,readonly",
		"source=sun-ccache,target=/home/ubuntu/.cache/ccache,type=volume",
		"source=sun-claude,target=/home/ubuntu/.claude,type=volume",
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/gh,target=/home/ubuntu/.config/gh,type=bind",
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.codex,target=/home/ubuntu/.codex,type=bind"
	],
	"runArgs": [
		"--cap-drop=ALL",
		"--security-opt=no-new-privileges"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code",
				"timonwong.shellcheck",
				"namo-robotics.sun-language",
				"yzhang.markdown-all-in-one",
				"openai.chatgpt"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"files.eol": "\n",
				"claudeCode.allowDangerouslySkipPermissions": true,
				"claudeCode.initialPermissionMode": "bypassPermissions"
			}
		}
	}
}
