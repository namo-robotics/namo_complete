# Copy to .env and fill in. .env is gitignored; this file is not.
#
#     cp .env.example .env && chmod 600 .env
#
# ./run.sh loads .env automatically.

# Optional for the terminal; required for agent requests.
ANTHROPIC_API_KEY=sk-ant-...

# Optional -- see the Configuration table in README.md.
# NAMO_MODEL=claude-opus-5
# NAMO_TIMEOUT=30
# NAMO_HISTORY_LINES=50      # 0 sends no shell history
# NAMO_NO_LS=0               # 1 sends no directory listing

# NAMO_LAYOUT=vertical      # horizontal stacks the terminal above the agent
# NAMO_AGENT_WINDOW=1       # 0 starts with the agent hidden
# NAMO_DISABLE=0            # 1 skips interactive integration
