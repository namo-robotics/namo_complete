# Copy to .env and fill in. .env is gitignored; this file is not.
#
#     cp .env.example .env && chmod 600 .env
#
# ./run.sh and ./test.sh load .env automatically.

# Required.
ANTHROPIC_API_KEY=sk-ant-...

# Optional -- see the Configuration table in README.md.
# NAMO_MODEL=claude-opus-5
# NAMO_TIMEOUT=10
# NAMO_HISTORY_LINES=50      # 0 sends no shell history
# NAMO_NO_LS=0               # 1 sends no directory listing
# NAMO_MAX_SUGGESTIONS=3
# NAMO_CACHE_TTL=900
# NAMO_MIN_GAP=1             # seconds between live calls; 0 disables throttling
